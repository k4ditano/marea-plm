// Marea's scene, in pieces: pulling her onto a window and letting go of it. marea.plm includes it.
part JoinRules {
    // ── pulling her ──────────────────────────────────────────────
    //  Pressing her and not moving is the click that opens her card (mouse.plm).
    //  Moving more than 10 px is pulling: a drop of her water buds off her and the surface of
    //  the perch takes it, with a thread back to her, while she stays where she lives and watches
    //  it; and the logic starts to look at which window is under it.
    on drag body_zone while drag.dx * drag.dx + drag.dy * drag.dy > 100 { dragged = true }
    on drag body_zone while join.can and drag.dx * drag.dx + drag.dy * drag.dy > 100 {
        join.phase = held
        needed = true
        wanted = true
        ball.x: hm.dx ~16ms
        ball.y: hm.dy ~16ms
        retract: 0 ~16ms
        seat: 0 ~16ms
        kid.bud: 0 ~16ms
        kid.bud: 1 after 40ms
        face = eye
        emit join_grab
    }
    //  She follows the pointer, which keeps pulling even when it has left her
    //  surface: the position is told in the surface that was pressed.
    on drag body_zone while join.phase == held {
        ptr.x = host.x + (host.w - 920) / 2 + pointer.x
        ptr.y = host.y + pointer.y
        ball.x: host.x + (host.w - 920) / 2 + pointer.x ~lively
        ball.y: host.y + pointer.y ~lively
    }
    //  Let go: over a window she falls; over nothing she goes back up.
    //  (Where she is let go is where the pull last told it: the release itself comes
    //  with no place in some compositors, 0,0, and that is the corner of her surface.)
    on release body_zone while join.phase == held {
        join.phase = waiting
        emit join_drop
    }
    on release body_zone while join.phase == none and not dragged { toggle open }
    //  If the logic does not answer she does not hang there.
    on still join.phase for 3s while join.phase == waiting { emit join_none }

    // ── the fall ─────────────────────────────────────────────────
    //  The logic found the window (its box is in `join.x…`). Pulled, she is
    //  already out and just falls from where she was let go; told from the
    //  keyboard, with nobody pulling her, she starts from the notch: the thread
    //  gives, and she drops down it.
    on join_land while join.phase == waiting {
        face = happy
        impulse wobble -200
        join.up = ball.y > tgt.y
        join.phase = falling
        pb.x: join.x ~16ms
        pb.y: join.y ~16ms
        pb.w: join.w ~16ms
        pb.h: join.h ~16ms
        ball.x: tgt.x ~spring(70, 11)
        ball.y: tgt.y ~spring(130, 21)
    }
    on join_land while join.phase == none {
        needed = true
        wanted = true
        face = happy
        impulse wobble -200
        retract: 0 ~16ms
        seat: 0 ~16ms
        kid.bud: 0 ~16ms
        kid.bud: 1 after 30ms
        join.up = false
        join.phase = falling
        pb.x: join.x ~16ms
        pb.y: join.y ~16ms
        pb.w: join.w ~16ms
        pb.h: join.h ~16ms
        ball.x: hm.dx ~16ms
        ball.y: hm.dy ~16ms
        ball.x: tgt.x ~spring(70, 11) after 120ms
        ball.y: tgt.y ~plunge after 120ms
    }
    //  It touches. The thread breaks and flies back into her, the water she lives in
    //  gives its tug, the child squashes and a spray goes up.
    on change join.hit while join.hit and join.phase == falling {
        join.phase = sitting
        seat: 1 ~140ms after 150ms
        play land
        retract: 1 ~240ms
        impulse bounce -150
        impulse wobble -340
        ripple: 0 ~16ms
        ripple: 1 ~900ms after 30ms
        pulse: 0 ~16ms
        pulse: 1 ~900ms after 30ms
        emit join_splash
        pill: 1 after 100ms
        face = happy
    }
    //  A fall that never arrived (a window that moved out from under her).
    on still join.phase for 1600ms while join.phase == falling { join.phase = sitting; seat: 1 ~140ms; retract: 1 ~240ms; pill: 1 after 120ms }
    //  The box has no exclusive hold on the keyboard: it asks for it on demand while it is
    //  shown (scene/surfaces/join.plm), so a click in the field gives it to her and a click on
    //  any window gives it to that window; she never keeps it from him. (A `focus` on the field
    //  asks for all of it as long as the surface may have it: it stayed asked for as long as she
    //  sat, so nothing was typed anywhere else.) Typing is therefore started by a click in the
    //  field; the first key after the drop still goes to the window that had the keyboard.

    // ── what she does while she is there ─────────────────────────
    //  Her face, as in the chat: waves while she thinks, a start when she
    //  needs you, and a hop when she is done.
    on change chat.state while chat.state == thinking and join.phase == sitting { face = reading }
    on change chat.state while chat.state == awaiting and join.phase == sitting { face = alert; impulse bounce -60 }
    on change chat.state while chat.state == idle and face == reading and join.phase == sitting { face = eye; play happy }
    //  Joined to a window: she stops being happy about falling after a moment.
    on still join.phase for 1400ms while join.phase == sitting and face == happy { face = eye }
    //  The whole chat, opened while she sits on a window, takes the box's place; closed,
    //  the box comes back.
    on change chatting while chatting and join.phase == sitting { pill: 0 ~200ms; join.typing = false }
    on change chatting while not chatting and join.phase == sitting { pill: 1 after 260ms }
    //  Enter in the box sends it, and the box gives the keyboard back; the chat
    //  panel stays closed: what she says is under her.
    //  (The box keeps the keyboard, so the next thing is typed at once; a click
    //  outside gives it back.)
    on submit join.input { emit join_send }
    on press jsend_btn while join.busy { emit chat_stop }
    on press jsend_btn while not join.busy { emit join_send }
    //  Her answer comes up out of the water, letter by letter.
    on change join.said_on while join.said_on { join.rev: 0 ~0ms; join.rev: 320 ~7000ms after 40ms }
    //  One of the others (finder, chat, a menu, the card) closed while she sits: the box stops asking
    //  for the keyboard for a moment (500 ms, more than the 300 ms pleamar keeps a lent keyboard),
    //  so that what they were lent is let go instead of being held by the box.
    on change kb.others while not kb.others and join.phase == sitting { join.settle = true }
    on still join.settle for 500ms while join.settle { join.settle = false }
    //  (Esc does not let go of the child: it closes the finder, the chat, the menus. The way to let
    //  go of it is its ×, the box's button, `chat_detach`, or its window closing.)
    //  A window carried by its title bar, told by the window manager: hers if the mouse is on
    //  its title bar, and then she goes with the mouse at once, from where it was taken.
    on carry_start while join.phase == sitting and not carry.on and join.screen == host.i and cl.x >= join.x - 20 and cl.x < join.x + join.w + 20 and cl.y >= join.y - 20 and cl.y < join.y + 56 {
        carry.gx = clamp(cl.x - join.x, 0, join.w)
        carry.gy = clamp(cl.y - join.y, 0, 34)
        carry.on = true
        emit carry_grab
    }
    //  Let go: where it was left is where it is (the list of windows says so a moment later).
    on carry_end while carry.on {
        join.x = cur.dx - carry.gx
        join.y = cur.dy - carry.gy
        carry.on = false
    }

    // ── letting go ───────────────────────────────────────────────
    //  The logic let go of the window (her button, Esc, `chat_detach`, the
    //  window closing): the child lifts off, a thread grows from her to meet it and it goes
    //  back into her, the way it came; she gives a happy little bob.
    on change chat.attached while not chat.attached and (join.phase == sitting or join.phase == falling) { join.phase = leaving }
    on join_none while join.phase == waiting { join.phase = leaving }
    on change join.phase while join.phase == leaving {
        join.typing = false
        hov.on = false
        pill: 0 ~220ms
        seat: 0 ~16ms
        ball.x: sit.x ~16ms
        ball.y: sit.y ~16ms
        retract: 0 ~200ms
        ball.x: hm.dx ~spring(70, 13) after 60ms
        ball.y: hm.dy ~spring(70, 13) after 60ms
        kid.bud: 0 ~spring(110, 15) after 260ms
    }
    //  It is in her when it has reached her. (And a rule that waits for a time is not safe
    //  against a reload of the scene, so the second one is the fallback: it just sends it the
    //  last few pixels.)
    let join.home = length(ball.x - hm.dx, ball.y - hm.dy) < 11
    on change join.home while join.home and join.phase == leaving {
        join.phase = none
        retract: 1 ~16ms
        kid.bud: 0 ~16ms
        kid.pulse: 0 ~16ms
        kid.pulse: 1 ~700ms after 30ms
        impulse bounce -110
        impulse wobble -90
        ripple: 0 ~16ms
        ripple: 1 ~760ms after 30ms
        face = happy
        play happy
    }
    on still join.phase for 900ms while join.phase == leaving { ball.x: hm.dx ~16ms; ball.y: hm.dy ~16ms }
    //  A little after, she is herself again.
    on still join.phase for 1300ms while join.phase == none and face == happy { face = eye }
}
