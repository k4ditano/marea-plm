// Marea's scene, in pieces: the surface where her children are pulled onto windows and sit on them. marea.plm includes it.
part JoinSurface {
    // ── the surface of the perch ─────────────────────────────────
    //  The whole monitor, open only while a child of hers is out of her for this: pulled, falling,
    //  sitting on a window or on its way back. It takes the mouse only where it has zones (the
    //  children, their boxes, their little «let go»), so the desktop under it stays the user's.
    //  A child sitting opens only the copy on the monitor of its window: one transparent surface of
    //  the size of a monitor costs little, but nothing needs two. One surface for the four: each
    //  child is drawn by the same lines (`repeat k in 0..4`), in its own hue.
    //
    //  She herself does not move: she stays where she lives, drawn by her own surface, and what is
    //  drawn here is a drop of her water of another colour (violet, coral, teal, amber, as she is
    //  mint), smaller than she is, joined to her by a thread of the same water until it lands.
    surface stick {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 3
        open: (ch.0.phase != none and not ch.0.hidden and (ch.0.phase != sitting or screen.index == ch.0.screen)) or (ch.1.phase != none and not ch.1.hidden and (ch.1.phase != sitting or screen.index == ch.1.screen)) or (ch.2.phase != none and not ch.2.hidden and (ch.2.phase != sitting or screen.index == ch.2.screen)) or (ch.3.phase != none and not ch.3.hidden and (ch.3.phase != sitting or screen.index == ch.3.screen))
        //  The keyboard is asked for on demand while a box is shown: a click in the field gives it to
        //  that child, a click on another window to that one. Never exclusive: it would keep his typing
        //  from every other window (rules/join.plm). Its condition (`ch.shown`, and `ch.settle`) is in
        //  the main surface's `keyboard: … while` in marea.plm, not here: a scene has only one
        //  condition for all its surfaces, and a second `while` here replaced the finder's.
        keyboard: on_demand
        //  Everything sitting and nobody writing, a breathing ring needs few frames.
        rate: 60, 30 while ch.calm and ch.working == 0 and not carry.any and kp.k < 0

        //  This copy's corner, in desktop pixels, and everything in its own.
        let mo.x = pick(screen.index, mon.x.0, mon.x.1, mon.x.2)
        let mo.y = pick(screen.index, mon.y.0, mon.y.1, mon.y.2)
        //  Joined, the rings on the windows breathe: slow (5 s), and only a fifth of their light.
        wave join.breath = if(ch.sit, 1, 0) at 1.2
        wave kid.beat = if(ch.new_any, 1, 0) at 4.5
        spin kid.t by if(ch.working > 0, 1, 0)
        //  Her, where she lives, in this copy's pixels: the threads are fixed on her.
        let hm.x = hm.dx - mo.x
        let hm.y = hm.dy - mo.y

        //  The window under the child that is pulled lights up and says its name, in its hue.
        let hv.k = if(ch.0.phase == held, 0, if(ch.1.phase == held, 1, if(ch.2.phase == held, 2, 3)))
        let hv.l = mix(mix(mix(kid, kid1, hv.k == 1), kid2, hv.k == 2), kid3, hv.k == 3)
        group {
            show: hov.a > 0.01
            opacity: hov.a
            box { at: hov.x - mo.x + hov.w / 2, hov.y - mo.y + hov.h / 2; size: hov.w + 8, hov.h + 8; corner: 18; color: hv.l; opacity: 8% }
            group {
                glow: 9, 80%, hv.l
                box { at: hov.x - mo.x + hov.w / 2, hov.y - mo.y + hov.h / 2; size: hov.w + 6, hov.h + 6; corner: 17; stroke: 2.2; color: hv.l; opacity: 90% }
            }
        }

        repeat k in 0..4 {
            //  ── its hue ──
            let c.l = mix(mix(mix(kid, kid1, k == 1), kid2, k == 2), kid3, k == 3)
            let c.top = mix(mix(mix(kid.top, kid1.top, k == 1), kid2.top, k == 2), kid3.top, k == 3)
            let c.bot = mix(mix(mix(kid.bot, kid1.bot, k == 1), kid2.bot, k == 2), kid3.bot, k == 3)
            let c.deep = mix(mix(mix(kid.deep, kid1.deep, k == 1), kid2.deep, k == 2), kid3.deep, k == 3)
            let c.mid = mix(mix(mix(kid.mid, kid1.mid, k == 1), kid2.mid, k == 2), kid3.mid, k == 3)
            let c.ink = mix(mix(mix(kid.ink, kid1.ink, k == 1), kid2.ink, k == 2), kid3.ink, k == 3)
            let c.sel = mix(mix(mix(kid.sel, kid1.sel, k == 1), kid2.sel, k == 2), kid3.sel, k == 3)
            //  It is working (the box says what).
            let bz = ch.$k.state == thinking or ch.$k.state == acting or ch.$k.state == awaiting or ch.$k.state == starting

            //  ── where it is ──
            //  Where it sits: along the top edge of its window, where it was let go (the window's
            //  frame is followed by springs, `px…`): the same lines as in scene/rules/join.plm.
            let k.my = pick(ch.$k.screen, mon.y.0, mon.y.1, mon.y.2)
            let k.sdx0 = clamp(ch.$k.dx, 34, max(ch.$k.pw - 34, 34))
            let k.sdx = if(k.sdx0 >= 480 or ch.$k.pw - k.sdx0 >= 480, k.sdx0, 34)
            let k.sx = ch.$k.px + k.sdx
            let k.sy = k.my + max(ch.$k.py - k.my - 22, 24)
            //  The child, where it is: pulled, on its way, or sitting (`seat`). A fall from above
            //  is cut at the window: the spring that drops it would carry it through.
            let st.fy = if(ch.$k.phase == falling or ch.$k.phase == sitting, if(ch.$k.up, max(ch.$k.by, k.sy), min(ch.$k.by, k.sy)), ch.$k.by)
            let st.x = ch.$k.bx + (k.sx - ch.$k.bx) * ch.$k.seat - mo.x
            let st.y = st.fy + (k.sy - st.fy) * ch.$k.seat - mo.y
            //  How big it is (a little under three quarters of her once it sits; a good deal smaller
            //  while it forms), and how fast it falls, which is what stretches it, as in the journey.
            let kk = (0.64 + 0.2 * ch.$k.seat) * ch.$k.bud
            let kd.r = max(23 * kk, 0.01)
            let st.stretch = clamp(vel(ch.$k.by) * 0.00028, 0, 0.3)
            //  Is there a ledge to sit on? With room above the window it sits on its edge
            //  and has a foot there; at the top of a monitor it is astride it instead.
            let st.ledge = clamp((k.sy - k.my - 24) / 10, 0, 1)
            let pu = clamp(ch.$k.pulse, 0, 1)

            //  ── the thread ──
            let th.ret = ch.$k.retract
            let kd.l = max(length(st.x - hm.x, st.y - hm.y), 1)
            //  Where it leaves her: a little inside her edge, on the side of the child.
            let rt.x = hm.x + (st.x - hm.x) / kd.l * 23
            let rt.y = hm.y + (st.y - hm.y) / kd.l * 23
            //  The tip of the thread: the child, until it breaks; then it flies back into her.
            let nt.x = st.x + (rt.x - st.x) * th.ret
            let nt.y = st.y + (rt.y - st.y) * th.ret
            let nt.len = length(nt.x - rt.x, nt.y - rt.y)
            //  It hangs behind when the child is pulled fast, and bows with its weight.
            let nc.x = (rt.x + nt.x) / 2 - clamp(vel(ch.$k.bx) * 0.045, -90, 90) * (1 - th.ret)
            let nc.y = (rt.y + nt.y) / 2 + clamp(nt.len * 0.09, 0, 46) * (1 - th.ret)
            //  Thick where it leaves her and where it reaches the child, thin between, and the
            //  longer it is the thinner: a thread of water, which is how it breaks.
            let th.keep = clamp(1 - nt.len / 520, 0.3, 1)
            let th.w0 = 11 * (1 - th.ret * 0.85) * clamp(ch.$k.bud * 1.5, 0, 1)
            let th.w1 = max(kd.r * 0.7, 3) * (1 - th.ret * 0.85)

            //  ── its box ──
            //  The box: 450 wide, on the side of the child with room for it, as tall as a line of
            //  15 px with air; it breathes a little while the child is idle. `pl.c.l` is where
            //  what is in it begins, clear of the child, and `jb.x` the send button at its far end.
            let pl.w0 = min(450, stick.width - 80)
            let pl.h = 32 * (1 + 0.03 * join.breath * clamp(ch.$k.pill, 0, 1))
            //  Inside its window: the box never leaves the window it works in, nor the screen. The
            //  window's edges in this copy's own pixels, and the room each side of the child has.
            let win.l = ch.$k.px - mo.x
            let win.r = ch.$k.px + ch.$k.pw - mo.x
            let pl.room.r = min(win.r, stick.width) - 10 - (st.x + kd.r - 4)
            let pl.room.l = (st.x - kd.r + 4) - max(win.l, 0) - 10
            let pl.fit.r = pl.room.r >= pl.w0
            let pl.fit.l = pl.room.l >= pl.w0
            //  Where the box goes: to the right if it fits in the window, unless it would cover her where
            //  she lives (then to the left, if it fits there); if neither fits whole, to the side with
            //  more room, and shorter.
            let pl.cover = st.y < hm.y + 44 and st.x - 10 < hm.x + 42 and st.x + kd.r + pl.w0 > hm.x - 42
            let pl.side = if(pl.fit.r and not (pl.cover and pl.fit.l), 1, if(pl.fit.l, -1, if(pl.room.r >= pl.room.l, 1, -1)))
            let pl.w = clamp(if(pl.side > 0, pl.room.r, pl.room.l), 170, pl.w0)
            let pl.cx = st.x + pl.side * (kd.r - 4 + pl.w * ch.$k.pill / 2)
            let jb.x = st.x + pl.side * (kd.r - 4 + pl.w - 17)
            let pl.c.l = if(pl.side > 0, st.x + kd.r + 9, jb.x + 22)
            let pl.fw = if(pl.side > 0, jb.x - 22 - pl.c.l, st.x - kd.r - 9 - pl.c.l)
            //  The squash of the child when the box opens (the spring of the box leads it).
            let st.sq = clamp(vel(ch.$k.pill) * 0.03, -0.12, 0.12)
            //  Where it looks: down when it is pulled, at its box when it sits.
            let st.gx = if(ch.$k.phase == sitting, pl.side * 4 * clamp(ch.$k.pill * 2, 0, 1), clamp(vel(ch.$k.bx) * 0.004, -3.5, 3.5))
            let st.gy = if(ch.$k.phase == sitting, 0, 3)
            //  What it answered, hanging under the box like a drop: how formed it is, and how tall
            //  (it is as tall as what it says, up to two fifths of the monitor and never past its bottom or its window's;
            //  longer than that, it scrolls). Its letters come up out of the water as they are let out.
            let bub.w = pl.w - 30
            let bub.t0 = st.y + pl.h / 2 + 9
            let bub.t = bub.t0 + ch.$k.cardo + ch.$k.qo
            let bub.maxh = max(min(min(stick.height * 0.4, stick.height - bub.t - 16), ch.$k.py + ch.$k.ph - mo.y - bub.t - 10), 110)
            let bub.x = pl.cx - pl.side * 6
            //  Whose window it is, in a tab on the ring that the window has: «Kitty» (and, while a task runs,
            //  the first words of it), its minimise button and the way out. It sits on the other side of the
            //  child from the box, or past the end of it.
            measure jname.$k
            let tb.w = jname.$k.width + 110
            let tb.room = st.x - kd.r - 12 - tb.w > max(win.l, 0) + 6
            let tb.cx0 = if(pl.side > 0, if(tb.room, st.x - kd.r - 12 - tb.w / 2, pl.cx + pl.w * clamp(ch.$k.pill, 0, 1) / 2 + 12 + tb.w / 2), st.x + kd.r + 12 + tb.w / 2)
            //  (And the tab stays on the window's ring, not past its end.)
            let tb.cx = clamp(tb.cx0, win.l + tb.w / 2 + 6, max(win.r - tb.w / 2 - 6, win.l + tb.w / 2 + 6))
            let tb.cy = max(ch.$k.py - mo.y, 17)
            zone box pill_zone.$k { at: pl.cx, st.y; size: pl.w * ch.$k.pill, pl.h; corner: 16; cursor: text; label: "Tell her what to do in this window"; active: ch.$k.phase == sitting and ch.$k.pill > 0.7 and not bz and ch.$k.visu > 0.5 }

            //  ── the ring of its window ──
            //  The one it has joined (the same ring as the lit one while it is pulled).
            group {
                show: ch.$k.lit > 0.01
                opacity: ch.$k.lit * ch.$k.visr
                box { at: ch.$k.px - mo.x + ch.$k.pw / 2, ch.$k.py - mo.y + ch.$k.ph / 2; size: ch.$k.pw + 6, ch.$k.ph + 6; corner: 17; color: c.l; opacity: 4% + 1.5% * join.breath }
                group {
                    glow: 8, 55% + 15% * join.breath, c.l
                    box { at: ch.$k.px - mo.x + ch.$k.pw / 2, ch.$k.py - mo.y + ch.$k.ph / 2; size: ch.$k.pw + 6, ch.$k.ph + 6; corner: 17; stroke: 2.2; color: c.l; opacity: 82% + 12% * join.breath }
                }
                //  Where it landed, the ring runs out along the edge once.
                box { at: ch.$k.px - mo.x + ch.$k.pw / 2, ch.$k.py - mo.y + ch.$k.ph / 2
                      size: ch.$k.pw + 6 + 90 * pu, ch.$k.ph + 6 + 90 * pu; corner: 17 + 45 * pu; stroke: 2.2; color: c.l
                      opacity: 70% * (1 - pu) * (1 - pu) }
            }
            //  Where it touches the window's edge: a soft light on it and a dark point under
            //  it, so it is sitting on it and not floating over it.
            group {
                //  Everything of the child but the ring: faded out while a window above its own covers its place.
                opacity: ch.$k.visu
                show: ch.$k.visu > 0.01
            group {
                show: ch.$k.seat > 0.05 and st.ledge > 0.05
                opacity: ch.$k.seat * st.ledge
                ellipse { at: st.x, ch.$k.py - mo.y + 1; radius: 56; scale: 1, 0.11; color: c.l; opacity: 34% }
                ellipse { at: st.x, ch.$k.py - mo.y + 3; radius: 22; scale: 1, 0.13; color: #05070a; opacity: 55% }
            }

            //  ── its tab ──
            //  A swelling of the window's own edge that says whose it is.
            group {
                opacity: ch.$k.tab
                show: ch.$k.tab > 0.02
                prop letgo.glow = 0 ~140ms
                prop tmin.glow = 0 ~140ms
                body {
                    gradient: 0, tb.cy - 13 to 0, tb.cy + 13, c.bot, c.deep
                    rim: 26%
                    shadow: 0, 3, 10, 34%, c.deep
                    box { at: tb.cx, tb.cy; size: tb.w, 26; corner: 13 }
                }
                box { at: tb.cx, tb.cy; size: tb.w, 26; corner: 13; stroke: 1.3; color: c.l; opacity: 70% + 14% * join.breath + 22% * ch.$k.wrun * kid.beat }
                ellipse { at: tb.cx - tb.w / 2 + 15, tb.cy; radius: 3.4; color: mix(c.l, amber, ch.$k.askfirst) }
                text ch.$k.label { at: tb.cx - tb.w / 2 + 26, tb.cy; anchor: left center; size: 13; weight: 600; color: c.ink; opacity: 1 - letgo.glow; width: 280; lines: 1; measure: jname.$k }
                text "Let go" { at: tb.cx - tb.w / 2 + 26, tb.cy; anchor: left center; size: 13; weight: 600; color: c.l; opacity: letgo.glow }
                //  Expand: its whole panel.
                prop texp.glow = 0 ~140ms
                ellipse { at: tb.cx + tb.w / 2 - 64, tb.cy; radius: 9.5; color: #ffffff; opacity: 10% + 16% * texp.glow }
                path { at: tb.cx + tb.w / 2 - 68.5, tb.cy - 4.5; color: c.ink; stroke: 1.4; opacity: 70% + 30% * texp.glow
                       move 5.5, 0; line 9, 0; line 9, 3.5 }
                path { at: tb.cx + tb.w / 2 - 68.5, tb.cy - 4.5; color: c.ink; stroke: 1.4; opacity: 70% + 30% * texp.glow
                       move 3.5, 9; line 0, 9; line 0, 5.5 }
                zone ellipse texp_btn.$k { at: tb.cx + tb.w / 2 - 64, tb.cy; radius: 12; cursor: pointer; label: "Open its panel"; active: ch.$k.phase == sitting and ch.$k.tab > 0.7 and ch.$k.visu > 0.5 }
                on enter texp_btn.$k { texp.glow: 1 }
                on leave texp_btn.$k { texp.glow: 0 }
                on press texp_btn.$k { emit kp_open(k) }
                //  Minimise: its answer to a chip, or (with no answer) the box and all.
                ellipse { at: tb.cx + tb.w / 2 - 40, tb.cy; radius: 9.5; color: #ffffff; opacity: 10% + 16% * tmin.glow }
                line { from: tb.cx + tb.w / 2 - 44, tb.cy; to: tb.cx + tb.w / 2 - 36, tb.cy; width: 1.7; color: c.ink; opacity: 70% + 30% * tmin.glow }
                zone ellipse tmin_btn.$k { at: tb.cx + tb.w / 2 - 40, tb.cy; radius: 12; cursor: pointer; label: "Minimise"; active: ch.$k.phase == sitting and ch.$k.tab > 0.7 and ch.$k.visu > 0.5 }
                on enter tmin_btn.$k { tmin.glow: 1 }
                on leave tmin_btn.$k { tmin.glow: 0 }
                on press tmin_btn.$k while ch.$k.said_on { toggle ch.$k.min }
                on press tmin_btn.$k while not ch.$k.said_on { toggle ch.$k.shut }
                ellipse { at: tb.cx + tb.w / 2 - 16, tb.cy; radius: 9.5; color: #ffffff; opacity: 10% + 16% * letgo.glow }
                line { from: tb.cx + tb.w / 2 - 19.5, tb.cy - 3.5; to: tb.cx + tb.w / 2 - 12.5, tb.cy + 3.5; width: 1.7; color: c.ink; opacity: 70% + 30% * letgo.glow }
                line { from: tb.cx + tb.w / 2 - 19.5, tb.cy + 3.5; to: tb.cx + tb.w / 2 - 12.5, tb.cy - 3.5; width: 1.7; color: c.ink; opacity: 70% + 30% * letgo.glow }
                zone ellipse letgo_btn.$k { at: tb.cx + tb.w / 2 - 16, tb.cy; radius: 13; cursor: pointer; label: "Let go of the window"; active: ch.$k.phase == sitting and ch.$k.tab > 0.7 and ch.$k.visu > 0.5 }
                on enter letgo_btn.$k { letgo.glow: 1 }
                on leave letgo_btn.$k { letgo.glow: 0 }
                on press letgo_btn.$k { emit chat_detach(k) }
            }

            //  ── the child ──
            //  A bud on her, the thread, the ball, the box that grows from it and the drop of its
            //  answer hanging from the box: one body of water, with a waist where the box leaves the
            //  ball. A halo of its own hue and a bright thin rim, so it reads over a dark window and
            //  over a light one.
            group {
                glow: 8, 36%, c.l
                show: ch.$k.phase != none
                body {
                    gradient: 0, st.y - 26 to 0, st.y + 26, c.top, c.bot
                    rim: 32%
                    glass: glassiness
                    lens: bends
                    tint: 75%
                    shadow: 0, 3, 12, 34%, c.deep
                    //  The bud on her, which the thread comes out of.
                    ellipse { at: rt.x, rt.y; radius: max(5.5 * (1 - th.ret) * clamp(ch.$k.bud * 1.5, 0, 1), 0.01); blend: 12 }
                    //  The thread: 32 capsules along the curve (a quadratic one from her to the
                    //  child's tip), each as wide as the middle of its span, thinner towards the
                    //  middle; their round ends hide the joins.
                    line { from: rt.x * 1, rt.y * 1; to: rt.x * 0.93848 + nc.x * 0.06055 + nt.x * 0.00098, rt.y * 0.93848 + nc.y * 0.06055 + nt.y * 0.00098; width: max((th.w0 + (th.w1 - th.w0) * 0.01562) * (1 - (1 - th.keep) * 0.06152), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.93848 + nc.x * 0.06055 + nt.x * 0.00098, rt.y * 0.93848 + nc.y * 0.06055 + nt.y * 0.00098; to: rt.x * 0.87891 + nc.x * 0.11719 + nt.x * 0.00391, rt.y * 0.87891 + nc.y * 0.11719 + nt.y * 0.00391; width: max((th.w0 + (th.w1 - th.w0) * 0.04688) * (1 - (1 - th.keep) * 0.17871), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.87891 + nc.x * 0.11719 + nt.x * 0.00391, rt.y * 0.87891 + nc.y * 0.11719 + nt.y * 0.00391; to: rt.x * 0.82129 + nc.x * 0.16992 + nt.x * 0.00879, rt.y * 0.82129 + nc.y * 0.16992 + nt.y * 0.00879; width: max((th.w0 + (th.w1 - th.w0) * 0.07812) * (1 - (1 - th.keep) * 0.28809), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.82129 + nc.x * 0.16992 + nt.x * 0.00879, rt.y * 0.82129 + nc.y * 0.16992 + nt.y * 0.00879; to: rt.x * 0.76562 + nc.x * 0.21875 + nt.x * 0.01562, rt.y * 0.76562 + nc.y * 0.21875 + nt.y * 0.01562; width: max((th.w0 + (th.w1 - th.w0) * 0.10938) * (1 - (1 - th.keep) * 0.38965), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.76562 + nc.x * 0.21875 + nt.x * 0.01562, rt.y * 0.76562 + nc.y * 0.21875 + nt.y * 0.01562; to: rt.x * 0.71191 + nc.x * 0.26367 + nt.x * 0.02441, rt.y * 0.71191 + nc.y * 0.26367 + nt.y * 0.02441; width: max((th.w0 + (th.w1 - th.w0) * 0.14062) * (1 - (1 - th.keep) * 0.4834), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.71191 + nc.x * 0.26367 + nt.x * 0.02441, rt.y * 0.71191 + nc.y * 0.26367 + nt.y * 0.02441; to: rt.x * 0.66016 + nc.x * 0.30469 + nt.x * 0.03516, rt.y * 0.66016 + nc.y * 0.30469 + nt.y * 0.03516; width: max((th.w0 + (th.w1 - th.w0) * 0.17188) * (1 - (1 - th.keep) * 0.56934), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.66016 + nc.x * 0.30469 + nt.x * 0.03516, rt.y * 0.66016 + nc.y * 0.30469 + nt.y * 0.03516; to: rt.x * 0.61035 + nc.x * 0.3418 + nt.x * 0.04785, rt.y * 0.61035 + nc.y * 0.3418 + nt.y * 0.04785; width: max((th.w0 + (th.w1 - th.w0) * 0.20312) * (1 - (1 - th.keep) * 0.64746), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.61035 + nc.x * 0.3418 + nt.x * 0.04785, rt.y * 0.61035 + nc.y * 0.3418 + nt.y * 0.04785; to: rt.x * 0.5625 + nc.x * 0.375 + nt.x * 0.0625, rt.y * 0.5625 + nc.y * 0.375 + nt.y * 0.0625; width: max((th.w0 + (th.w1 - th.w0) * 0.23438) * (1 - (1 - th.keep) * 0.71777), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.5625 + nc.x * 0.375 + nt.x * 0.0625, rt.y * 0.5625 + nc.y * 0.375 + nt.y * 0.0625; to: rt.x * 0.5166 + nc.x * 0.4043 + nt.x * 0.0791, rt.y * 0.5166 + nc.y * 0.4043 + nt.y * 0.0791; width: max((th.w0 + (th.w1 - th.w0) * 0.26562) * (1 - (1 - th.keep) * 0.78027), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.5166 + nc.x * 0.4043 + nt.x * 0.0791, rt.y * 0.5166 + nc.y * 0.4043 + nt.y * 0.0791; to: rt.x * 0.47266 + nc.x * 0.42969 + nt.x * 0.09766, rt.y * 0.47266 + nc.y * 0.42969 + nt.y * 0.09766; width: max((th.w0 + (th.w1 - th.w0) * 0.29688) * (1 - (1 - th.keep) * 0.83496), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.47266 + nc.x * 0.42969 + nt.x * 0.09766, rt.y * 0.47266 + nc.y * 0.42969 + nt.y * 0.09766; to: rt.x * 0.43066 + nc.x * 0.45117 + nt.x * 0.11816, rt.y * 0.43066 + nc.y * 0.45117 + nt.y * 0.11816; width: max((th.w0 + (th.w1 - th.w0) * 0.32812) * (1 - (1 - th.keep) * 0.88184), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.43066 + nc.x * 0.45117 + nt.x * 0.11816, rt.y * 0.43066 + nc.y * 0.45117 + nt.y * 0.11816; to: rt.x * 0.39062 + nc.x * 0.46875 + nt.x * 0.14062, rt.y * 0.39062 + nc.y * 0.46875 + nt.y * 0.14062; width: max((th.w0 + (th.w1 - th.w0) * 0.35938) * (1 - (1 - th.keep) * 0.9209), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.39062 + nc.x * 0.46875 + nt.x * 0.14062, rt.y * 0.39062 + nc.y * 0.46875 + nt.y * 0.14062; to: rt.x * 0.35254 + nc.x * 0.48242 + nt.x * 0.16504, rt.y * 0.35254 + nc.y * 0.48242 + nt.y * 0.16504; width: max((th.w0 + (th.w1 - th.w0) * 0.39062) * (1 - (1 - th.keep) * 0.95215), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.35254 + nc.x * 0.48242 + nt.x * 0.16504, rt.y * 0.35254 + nc.y * 0.48242 + nt.y * 0.16504; to: rt.x * 0.31641 + nc.x * 0.49219 + nt.x * 0.19141, rt.y * 0.31641 + nc.y * 0.49219 + nt.y * 0.19141; width: max((th.w0 + (th.w1 - th.w0) * 0.42188) * (1 - (1 - th.keep) * 0.97559), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.31641 + nc.x * 0.49219 + nt.x * 0.19141, rt.y * 0.31641 + nc.y * 0.49219 + nt.y * 0.19141; to: rt.x * 0.28223 + nc.x * 0.49805 + nt.x * 0.21973, rt.y * 0.28223 + nc.y * 0.49805 + nt.y * 0.21973; width: max((th.w0 + (th.w1 - th.w0) * 0.45312) * (1 - (1 - th.keep) * 0.99121), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.28223 + nc.x * 0.49805 + nt.x * 0.21973, rt.y * 0.28223 + nc.y * 0.49805 + nt.y * 0.21973; to: rt.x * 0.25 + nc.x * 0.5 + nt.x * 0.25, rt.y * 0.25 + nc.y * 0.5 + nt.y * 0.25; width: max((th.w0 + (th.w1 - th.w0) * 0.48438) * (1 - (1 - th.keep) * 0.99902), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.25 + nc.x * 0.5 + nt.x * 0.25, rt.y * 0.25 + nc.y * 0.5 + nt.y * 0.25; to: rt.x * 0.21973 + nc.x * 0.49805 + nt.x * 0.28223, rt.y * 0.21973 + nc.y * 0.49805 + nt.y * 0.28223; width: max((th.w0 + (th.w1 - th.w0) * 0.51562) * (1 - (1 - th.keep) * 0.99902), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.21973 + nc.x * 0.49805 + nt.x * 0.28223, rt.y * 0.21973 + nc.y * 0.49805 + nt.y * 0.28223; to: rt.x * 0.19141 + nc.x * 0.49219 + nt.x * 0.31641, rt.y * 0.19141 + nc.y * 0.49219 + nt.y * 0.31641; width: max((th.w0 + (th.w1 - th.w0) * 0.54688) * (1 - (1 - th.keep) * 0.99121), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.19141 + nc.x * 0.49219 + nt.x * 0.31641, rt.y * 0.19141 + nc.y * 0.49219 + nt.y * 0.31641; to: rt.x * 0.16504 + nc.x * 0.48242 + nt.x * 0.35254, rt.y * 0.16504 + nc.y * 0.48242 + nt.y * 0.35254; width: max((th.w0 + (th.w1 - th.w0) * 0.57812) * (1 - (1 - th.keep) * 0.97559), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.16504 + nc.x * 0.48242 + nt.x * 0.35254, rt.y * 0.16504 + nc.y * 0.48242 + nt.y * 0.35254; to: rt.x * 0.14062 + nc.x * 0.46875 + nt.x * 0.39062, rt.y * 0.14062 + nc.y * 0.46875 + nt.y * 0.39062; width: max((th.w0 + (th.w1 - th.w0) * 0.60938) * (1 - (1 - th.keep) * 0.95215), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.14062 + nc.x * 0.46875 + nt.x * 0.39062, rt.y * 0.14062 + nc.y * 0.46875 + nt.y * 0.39062; to: rt.x * 0.11816 + nc.x * 0.45117 + nt.x * 0.43066, rt.y * 0.11816 + nc.y * 0.45117 + nt.y * 0.43066; width: max((th.w0 + (th.w1 - th.w0) * 0.64062) * (1 - (1 - th.keep) * 0.9209), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.11816 + nc.x * 0.45117 + nt.x * 0.43066, rt.y * 0.11816 + nc.y * 0.45117 + nt.y * 0.43066; to: rt.x * 0.09766 + nc.x * 0.42969 + nt.x * 0.47266, rt.y * 0.09766 + nc.y * 0.42969 + nt.y * 0.47266; width: max((th.w0 + (th.w1 - th.w0) * 0.67188) * (1 - (1 - th.keep) * 0.88184), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.09766 + nc.x * 0.42969 + nt.x * 0.47266, rt.y * 0.09766 + nc.y * 0.42969 + nt.y * 0.47266; to: rt.x * 0.0791 + nc.x * 0.4043 + nt.x * 0.5166, rt.y * 0.0791 + nc.y * 0.4043 + nt.y * 0.5166; width: max((th.w0 + (th.w1 - th.w0) * 0.70312) * (1 - (1 - th.keep) * 0.83496), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.0791 + nc.x * 0.4043 + nt.x * 0.5166, rt.y * 0.0791 + nc.y * 0.4043 + nt.y * 0.5166; to: rt.x * 0.0625 + nc.x * 0.375 + nt.x * 0.5625, rt.y * 0.0625 + nc.y * 0.375 + nt.y * 0.5625; width: max((th.w0 + (th.w1 - th.w0) * 0.73438) * (1 - (1 - th.keep) * 0.78027), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.0625 + nc.x * 0.375 + nt.x * 0.5625, rt.y * 0.0625 + nc.y * 0.375 + nt.y * 0.5625; to: rt.x * 0.04785 + nc.x * 0.3418 + nt.x * 0.61035, rt.y * 0.04785 + nc.y * 0.3418 + nt.y * 0.61035; width: max((th.w0 + (th.w1 - th.w0) * 0.76562) * (1 - (1 - th.keep) * 0.71777), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.04785 + nc.x * 0.3418 + nt.x * 0.61035, rt.y * 0.04785 + nc.y * 0.3418 + nt.y * 0.61035; to: rt.x * 0.03516 + nc.x * 0.30469 + nt.x * 0.66016, rt.y * 0.03516 + nc.y * 0.30469 + nt.y * 0.66016; width: max((th.w0 + (th.w1 - th.w0) * 0.79688) * (1 - (1 - th.keep) * 0.64746), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.03516 + nc.x * 0.30469 + nt.x * 0.66016, rt.y * 0.03516 + nc.y * 0.30469 + nt.y * 0.66016; to: rt.x * 0.02441 + nc.x * 0.26367 + nt.x * 0.71191, rt.y * 0.02441 + nc.y * 0.26367 + nt.y * 0.71191; width: max((th.w0 + (th.w1 - th.w0) * 0.82812) * (1 - (1 - th.keep) * 0.56934), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.02441 + nc.x * 0.26367 + nt.x * 0.71191, rt.y * 0.02441 + nc.y * 0.26367 + nt.y * 0.71191; to: rt.x * 0.01562 + nc.x * 0.21875 + nt.x * 0.76562, rt.y * 0.01562 + nc.y * 0.21875 + nt.y * 0.76562; width: max((th.w0 + (th.w1 - th.w0) * 0.85938) * (1 - (1 - th.keep) * 0.4834), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.01562 + nc.x * 0.21875 + nt.x * 0.76562, rt.y * 0.01562 + nc.y * 0.21875 + nt.y * 0.76562; to: rt.x * 0.00879 + nc.x * 0.16992 + nt.x * 0.82129, rt.y * 0.00879 + nc.y * 0.16992 + nt.y * 0.82129; width: max((th.w0 + (th.w1 - th.w0) * 0.89062) * (1 - (1 - th.keep) * 0.38965), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.00879 + nc.x * 0.16992 + nt.x * 0.82129, rt.y * 0.00879 + nc.y * 0.16992 + nt.y * 0.82129; to: rt.x * 0.00391 + nc.x * 0.11719 + nt.x * 0.87891, rt.y * 0.00391 + nc.y * 0.11719 + nt.y * 0.87891; width: max((th.w0 + (th.w1 - th.w0) * 0.92188) * (1 - (1 - th.keep) * 0.28809), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.00391 + nc.x * 0.11719 + nt.x * 0.87891, rt.y * 0.00391 + nc.y * 0.11719 + nt.y * 0.87891; to: rt.x * 0.00098 + nc.x * 0.06055 + nt.x * 0.93848, rt.y * 0.00098 + nc.y * 0.06055 + nt.y * 0.93848; width: max((th.w0 + (th.w1 - th.w0) * 0.95312) * (1 - (1 - th.keep) * 0.17871), 2.2); blend: 2; show: th.ret < 0.97 }
                    line { from: rt.x * 0.00098 + nc.x * 0.06055 + nt.x * 0.93848, rt.y * 0.00098 + nc.y * 0.06055 + nt.y * 0.93848; to: nt.x * 1, nt.y * 1; width: max((th.w0 + (th.w1 - th.w0) * 0.98438) * (1 - (1 - th.keep) * 0.06152), 2.2); blend: 2; show: th.ret < 0.97 }
                    ellipse {
                        at: st.x, st.y
                        radius: kd.r
                        scale: (sx + st.sq) * (1 - st.stretch * 0.5), (sy - st.sq) * (1 + st.stretch)
                        blend: 16
                    }
                    //  The box: it leaves the ball through a waist, and is its water too.
                    box {
                        at: pl.cx, st.y
                        size: pl.w * ch.$k.pill, pl.h * clamp(ch.$k.pill * 2.4, 0, 1)
                        corner: 16
                        blend: 10 + 30 * clamp(ch.$k.pill * (1 - ch.$k.pill) * 4, 0, 1)
                        show: ch.$k.pill > 0.02
                    }
                }
            }
            //  The light on the water: a soft glint on the ball and a thin one along the top of the
            //  box, as on a drop, so it is glass and not a flat shape.
            group {
                blur: 1.4
                show: ch.$k.phase != none
                ellipse { at: st.x - kd.r * 0.36, st.y - kd.r * 0.5; radius: kd.r * 0.3; scale: 1.6, 0.62; rotate: -32deg; color: #ffffff; opacity: 26% }
                line { from: pl.cx - pl.w * ch.$k.pill / 2 + 24, st.y - pl.h / 2 + 5; to: pl.cx + pl.w * ch.$k.pill / 2 - 24, st.y - pl.h / 2 + 5; width: 2.6; color: #ffffff; opacity: 11% * clamp(ch.$k.pill * 2 - 1, 0, 1) }
            }
            //  The tide inside the box while it works: the light water throws on a pool's floor.
            shader chat_tide { at: pl.cx - pl.w * ch.$k.pill / 2, st.y - pl.h / 2; size: pl.w * ch.$k.pill, pl.h; corner: 16; values: ch.$k.stir * 2.4; colors: c.l }
            //  Its face: hers, smaller with it. It is her face, so her waves are on it while any of her
            //  children works: one that is not working keeps two plain eyes of its own meanwhile.
            group {
                pivot: st.x, st.y
                scale: kk, kk
                show: ch.$k.phase != none and (face != reading or bz)
                Face(st.x, st.y, st.gx / max(kk, 0.2), st.gy / max(kk, 0.2), 0)
            }
            group {
                show: ch.$k.phase != none and face == reading and not bz
                box { at: st.x + st.gx - 6.5 * kk, st.y + st.gy; size: 5 * kk, 13 * kk; corner: 2.5 * kk; color: #f5f7f5 }
                box { at: st.x + st.gx + 6.5 * kk, st.y + st.gy; size: 5 * kk, 13 * kk; corner: 2.5 * kk; color: #f5f7f5 }
            }
            //  The drops that go up where it lands, and fall back.
            particles { at: st.x, k.sy + kd.r - 2 - mo.y; area: 36, 2; count: 26; life: 0.35s .. 0.7s; speed: 80 .. 260
                        direction: -90deg; spread: 140deg; gravity: 0, 720; size: 4, 1; colors: c.ink, c.l; opacity: 95%, 0%
                        shape: dot; burst: splash.$k }

            //  What it says by it while it is pulled: the name of the window it is over, or that it
            //  has to be one (or that the window has a child already).
            group {
                show: ch.$k.phase == held
                measure hname.$k
                let h.y = st.y + kd.r + 26
                let h.w = if(hov.on, hname.$k.width + 34, 184)
                body {
                    gradient: 0, h.y - 14 to 0, h.y + 14, c.bot, c.deep
                    rim: 30%
                    shadow: 0, 3, 10, 34%, c.deep
                    box { at: st.x, h.y; size: h.w, 28; corner: 14 }
                }
                box { at: st.x, h.y; size: h.w, 28; corner: 14; stroke: 1.2; color: c.l; opacity: 55% + hov.a * 25% }
                text hov.app { at: st.x, h.y; anchor: center; size: 14; weight: 600; color: c.ink; width: 260; lines: 1; opacity: hov.a * if(hov.taken, 0, 1); measure: hname.$k }
                text "Already has a child" { at: st.x, h.y; anchor: center; size: 13; color: kid1; opacity: hov.a * if(hov.taken, 1, 0) }
                text "Drop me on a window" { at: st.x, h.y; anchor: center; size: 13; color: c.l; opacity: 1 - hov.a }
            }

            //  ── what is in its box ──
            //  The task goes in it, and while the child works it says what it is doing, in words.
            group {
                opacity: clamp(ch.$k.pill * 3 - 2, 0, 1)
                show: ch.$k.pill > 0.7
                //  Where it writes. A password never goes through here: it is the chat's
                //  field that turns into one.
                input ch.$k.input { at: pl.c.l, st.y - 10; width: pl.fw; size: 15; color: c.ink
                                    placeholder: "Tell me what to do in this window…"
                                    selection: c.sel; show: not bz or ch.$k.wrun > 0.5 }
                //  And while it works, what it is on, with a place to write what comes next (it waits its turn). Where
                //  it thinks or acts there is a Pause button beside the Stop, on the inner side.
                let jx.p = if((ch.$k.state == thinking or ch.$k.state == acting) and ch.$k.wrun < 0.5, 32, 0)
                let jx.l = pl.c.l + if(pl.side > 0, 0, jx.p)
                let jx.w = pl.fw - jx.p
                text ch.$k.status { at: jx.l, st.y; anchor: left center; size: 14; color: c.ink; width: jx.w * 0.44; lines: 1; show: bz and ch.$k.wrun < 0.5 }
                input ch.$k.input { at: jx.l + jx.w * 0.46 + 6, st.y - 9; width: jx.w * 0.54 - 10; size: 14; color: c.ink
                                    placeholder: "Next…"
                                    selection: c.sel; show: bz and ch.$k.state != awaiting and ch.$k.wrun < 0.5 }
                text ch.$k.status { at: pl.c.l, st.y; anchor: left center; size: 14; color: #ffb4a6; width: pl.fw; lines: 1; show: ch.$k.state == offline }
                //  Send: a tinted drop with a clear arrow; Stop: a ring with a calm coral square.
                prop jsend.glow = 0 ~140ms
                ellipse { at: jb.x, st.y; radius: 13 + 1 * jsend.glow; color: c.l; opacity: 88% + 12% * jsend.glow; show: not bz }
                path { at: jb.x - 4.5, st.y - 6; color: c.deep; stroke: 2.3; show: not bz
                       move 4.5, 12; line 4.5, 1.2 }
                path { at: jb.x - 4.5, st.y - 6; color: c.deep; stroke: 2.3; show: not bz
                       move 0.4, 5.2; line 4.5, 1.2; line 8.6, 5.2 }
                //  Pause (what it would do next waits) and Resume, while it thinks or acts.
                prop jpause.glow = 0 ~140ms
                let jp.x = jb.x - pl.side * 32
                group {
                    show: (ch.$k.state == thinking or ch.$k.state == acting) and ch.$k.wrun < 0.5
                    ellipse { at: jp.x, st.y; radius: 11.5 + 1 * jpause.glow; color: #ffffff; opacity: 12% + 16% * jpause.glow }
                    box { at: jp.x - 3, st.y; size: 2.8, 10; corner: 1; color: c.ink; show: not ch.$k.paused }
                    box { at: jp.x + 3, st.y; size: 2.8, 10; corner: 1; color: c.ink; show: not ch.$k.paused }
                    path { at: jp.x - 3, st.y - 5; color: amber; stroke: 2; show: ch.$k.paused
                           move 0, 0; line 8, 5; line 0, 10; line 0, 0 }
                }
                zone ellipse jpause_btn.$k { at: jp.x, st.y; radius: 14; cursor: pointer; label: "Pause or resume it"; active: ch.$k.phase == sitting and ch.$k.pill > 0.7 and (ch.$k.state == thinking or ch.$k.state == acting) and ch.$k.wrun < 0.5 and ch.$k.visu > 0.5 }
                on enter jpause_btn.$k { jpause.glow: 1 }
                on leave jpause_btn.$k { jpause.glow: 0 }
                on press jpause_btn.$k { emit kid_pause(k) }
                ellipse { at: jb.x, st.y; radius: 13; stroke: 1.8; color: #ffa797; opacity: 75% + 25% * jsend.glow; show: bz }
                box { at: jb.x, st.y; size: 9, 9; corner: 2.5; color: #ffa797; show: bz }
                zone ellipse jsend_btn.$k { at: jb.x, st.y; radius: 16; cursor: pointer; label: "Send"; active: ch.$k.phase == sitting and ch.$k.pill > 0.7 and ch.$k.visu > 0.5 }
                on enter jsend_btn.$k { jsend.glow: 1 }
                on leave jsend_btn.$k { jsend.glow: 0 }
                on submit ch.$k.input { emit join_send(k) }
                on press jsend_btn.$k while bz { emit kid_stop(k) }
                on press jsend_btn.$k while not bz { emit join_send(k) }
            }

            //  ── what it answered ──
            //  The drop under its box (scene/draw/kidsay.plm).
            KidSay(bub.x, bub.t, bub.w, ch.$k.bub * ch.$k.visu, ch.$k.said, ch.$k.rev, kid_min.$k, kid_exp.$k, bub.maxh, c.l, c.mid, c.deep, c.ink, c.sel)
            //  A step that waits for you (when it asks first), and what you wrote while it works.
            KidCard(bub.x, bub.t0, bub.w, clamp(ch.$k.cardo / 108, 0, 1) * clamp(ch.$k.pill * 2 - 1, 0, 1), ch.$k.card, ch.$k.cardbody, kid_yes.$k, kid_no.$k, c.ink)
            repeat i in 0..3 {
                group {
                    show: ch.$k.q > i and ch.$k.pill > 0.7
                    opacity: clamp(ch.$k.pill * 3 - 2, 0, 1)
                    prop unq.glow = 0 ~140ms
                    let qc.y = bub.t0 + ch.$k.cardo + 14 + 28 * i
                    box { at: bub.x, qc.y; size: bub.w, 24; corner: 12; color: c.mid; opacity: 85% }
                    box { at: bub.x, qc.y; size: bub.w, 24; corner: 12; stroke: 1; color: c.l; opacity: 40% }
                    text "next" { at: bub.x - bub.w / 2 + 14, qc.y; anchor: left center; size: 10.5; weight: 700; color: c.l }
                    text ch.$k.n.$i { at: bub.x - bub.w / 2 + 52, qc.y; anchor: left center; size: 12; color: c.ink; width: bub.w - 100; lines: 1 }
                    ellipse { at: bub.x + bub.w / 2 - 14, qc.y; radius: 8.5; color: #ffffff; opacity: 10% + 16% * unq.glow }
                    line { from: bub.x + bub.w / 2 - 17.5, qc.y - 3.5; to: bub.x + bub.w / 2 - 10.5, qc.y + 3.5; width: 1.5; color: c.ink }
                    line { from: bub.x + bub.w / 2 - 17.5, qc.y + 3.5; to: bub.x + bub.w / 2 - 10.5, qc.y - 3.5; width: 1.5; color: c.ink }
                    zone ellipse unq_btn.$k.$i { at: bub.x + bub.w / 2 - 14, qc.y; radius: 12; cursor: pointer; label: "Take it out of the line"; active: ch.$k.q > i and ch.$k.pill > 0.7 and ch.$k.visu > 0.5 }
                    on enter unq_btn.$k.$i { unq.glow: 1 }
                    on leave unq_btn.$k.$i { unq.glow: 0 }
                    on press unq_btn.$k.$i { emit kid_unq(k * 3 + i) }
                }
            }

            //  ── the chip ──
            //  What stands in for the answer while it is minimised (and for the whole box while that is put
            //  away, with a double press on the child): a spinner while it works, a beating dot when a new
            //  answer came, a little speech bubble otherwise. Pressed, everything comes back.
            group {
                opacity: ch.$k.chip
                show: ch.$k.chip > 0.02
                prop chip.glow = 0 ~140ms
                let cp.x = if(ch.$k.shut, st.x + pl.side * (kd.r + 26), bub.x - bub.w / 2 + 20)
                let cp.y = if(ch.$k.shut, st.y, bub.t + 18)
                body {
                    gradient: 0, cp.y - 15 to 0, cp.y + 15, c.bot, c.deep
                    rim: 26%
                    shadow: 0, 3, 10, 34%, c.deep
                    ellipse { at: cp.x, cp.y; radius: 15 + 1 * chip.glow }
                }
                ellipse { at: cp.x, cp.y; radius: 15 + 1 * chip.glow; stroke: 1.3; color: c.l; opacity: 70% + 20% * chip.glow }
                //  It works.
                arc { at: cp.x, cp.y; radius: 7; span: 110deg; width: 2.2; rotate: kid.t * 360deg; color: c.ink; show: bz }
                //  A new answer: the dot beats.
                ellipse { at: cp.x, cp.y; radius: 4.5 + 1.2 * kid.beat; color: c.l; show: ch.$k.new and not bz }
                ellipse { at: cp.x, cp.y; radius: 9 + 4 * kid.beat; stroke: 1.4; color: c.l; opacity: 55% - 35% * kid.beat; show: ch.$k.new and not bz }
                //  Nothing new.
                box { at: cp.x, cp.y - 1; size: 13, 10; corner: 3.5; stroke: 1.5; color: c.ink; opacity: 85%; show: not bz and not ch.$k.new }
                path { at: cp.x - 3, cp.y + 3.5; color: c.ink; stroke: 1.5; opacity: 85%; show: not bz and not ch.$k.new
                       move 0, 0; line 0.5, 3.5; line 4, 0 }
                zone ellipse chip_btn.$k { at: cp.x, cp.y; radius: 17; cursor: pointer; label: "Show its answer"; active: ch.$k.chip > 0.7 and ch.$k.visu > 0.5 }
                on enter chip_btn.$k { chip.glow: 1 }
                on leave chip_btn.$k { chip.glow: 0 }
                on press chip_btn.$k { ch.$k.min = false; ch.$k.shut = false }
            }
            }

            //  The child itself answers to a double press: it puts its box and answer away (it stays on the
            //  ring of its window), or brings them back.
            zone ellipse kball.$k { at: st.x, st.y; radius: kd.r + 1; cursor: pointer; label: "Put away the box (double press)"; active: ch.$k.phase == sitting and ch.$k.seat > 0.9 and ch.$k.tab > 0.7 and ch.$k.visu > 0.5 }
            on press kball.$k while ch.$k.dbl { toggle ch.$k.shut; ch.$k.dbl = false }
            on press kball.$k while not ch.$k.dbl { ch.$k.dbl = true }
        }

        // ── the panel of the child that has it open ──
        //  Over its window, near its top edge (and inside the monitor): up to 520 by 640.
        let kp.i = clamp(kp.k, 0, 3)
        let kp.c.l = mix(mix(mix(kid, kid1, kp.i == 1), kid2, kp.i == 2), kid3, kp.i == 3)
        let kp.c.mid = mix(mix(mix(kid.mid, kid1.mid, kp.i == 1), kid2.mid, kp.i == 2), kid3.mid, kp.i == 3)
        let kp.c.deep = mix(mix(mix(kid.deep, kid1.deep, kp.i == 1), kid2.deep, kp.i == 2), kid3.deep, kp.i == 3)
        let kp.c.ink = mix(mix(mix(kid.ink, kid1.ink, kp.i == 1), kid2.ink, kp.i == 2), kid3.ink, kp.i == 3)
        let kp.win.x = pick(kp.i, ch.0.px, ch.1.px, ch.2.px, ch.3.px) - mo.x
        let kp.win.y = pick(kp.i, ch.0.py, ch.1.py, ch.2.py, ch.3.py) - mo.y
        let kp.win.w = pick(kp.i, ch.0.pw, ch.1.pw, ch.2.pw, ch.3.pw)
        let kp.win.h = pick(kp.i, ch.0.ph, ch.1.ph, ch.2.ph, ch.3.ph)
        let kp.w = clamp(kp.win.w - 24, 500, 520)
        let kp.h = clamp(min(640, kp.win.h - 56), 380, stick.height - 24)
        let kp.x = clamp(kp.win.x + kp.win.w / 2 - kp.w / 2, 8, max(stick.width - kp.w - 8, 8))
        let kp.y = clamp(kp.win.y + 44, 8, max(stick.height - kp.h - 8, 8))
        let kp.work = pick(kp.i, ch.0.state == thinking or ch.0.state == acting or ch.0.state == awaiting or ch.0.state == starting, ch.1.state == thinking or ch.1.state == acting or ch.1.state == awaiting or ch.1.state == starting, ch.2.state == thinking or ch.2.state == acting or ch.2.state == awaiting or ch.2.state == starting, ch.3.state == thinking or ch.3.state == acting or ch.3.state == awaiting or ch.3.state == starting)
        KidPanel(kp.x, kp.y, kp.w, kp.h, kp.o * pick(kp.i, ch.0.visu, ch.1.visu, ch.2.visu, ch.3.visu), kp.i, kp.c.l, kp.c.mid, kp.c.deep, kp.c.ink, kp.work, pick(kp.i, ch.0.paused, ch.1.paused, ch.2.paused, ch.3.paused), pick(kp.i, ch.0.askfirst, ch.1.askfirst, ch.2.askfirst, ch.3.askfirst), pick(kp.i, ch.0.q, ch.1.q, ch.2.q, ch.3.q), pick(kp.i, ch.0.wn, ch.1.wn, ch.2.wn, ch.3.wn))
        //  Where you write in it (below its thread), and Enter.
        input kp.input { at: kp.x + 30, kp.y + kp.h - 41; width: kp.w - 100; size: 14; color: kp.c.ink; placeholder: "Tell it what to do next…"; selection: kp.c.mid; show: kp.o > 0.5 }
        on submit kp.input { emit kp_send }
    }
}
