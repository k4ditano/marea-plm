// Marea's scene, in pieces: the surface where she is pulled onto a window and sits on it. marea.plm includes it.
part JoinSurface {
    // ── the surface of the perch ─────────────────────────────────
    //  The whole monitor, open only while she is out of her place for this: held,
    //  falling, sitting on a window or on her way back. It takes the mouse only
    //  where it has zones (her, her box, the little «let go»), so the desktop
    //  under it stays the user's. Sitting, only the copy on the monitor of the
    //  window is open: one transparent surface of the size of a monitor costs
    //  little, but nothing needs two.
    surface stick {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 3
        open: join.phase != none and (join.phase != sitting or screen.index == join.screen)
        //  The box holds the keyboard while it is being written in; the scene's
        //  `focus` on it, with no click, asks for all of it until `join.typing`
        //  stops (Enter, Esc, a click away), and gives it back then.
        keyboard: on_demand while join.typing
        //  Sitting and not being written to, a breathing ring needs few frames.
        rate: 60, 20 while join.phase == sitting and not join.typing and not join.busy

        //  This copy's corner, in desktop pixels, and everything in its own.
        let mo.x = pick(screen.index, mon.x.0, mon.x.1, mon.x.2)
        let mo.y = pick(screen.index, mon.y.0, mon.y.1, mon.y.2)
        //  Her, where she is: pulled, on her way, or sitting (`seat`). A fall from above
        //  is cut at the window: the spring that drops her would carry her through it.
        let st.fy = if(join.phase == falling or join.phase == sitting, if(join.up, max(ball.y, sit.y), min(ball.y, sit.y)), ball.y)
        let st.x = ball.x + (sit.x - ball.x) * seat - mo.x
        let st.y = st.fy + (sit.y - st.fy) * seat - mo.y
        //  Is there a ledge to sit on? With room above the window she sits on its edge
        //  and has a foot there; at the top of a monitor she is astride it instead.
        let st.ledge = clamp((sit.y - sit.my - 14) / 10, 0, 1)
        //  The notch, where the thread is fixed.
        let join.pu = clamp(pulse, 0, 1)
        //  Joined, the ring on the window breathes: slow (5 s), and only a fifth of its light.
        wave join.breath = if(join.phase == sitting, 1, 0) at 1.2
        let nk.x = anc.x - mo.x
        let nk.y = anc.y - mo.y
        //  The tip of the thread: her, until it breaks; then it flies back up to the notch.
        let nt.x = st.x + (nk.x - st.x) * retract
        let nt.y = st.y + (nk.y - st.y) * retract
        let nt.len = length(nt.x - nk.x, nt.y - nk.y)
        //  It hangs behind her when she is pulled fast, and bows with the weight.
        let nc.x = (nk.x + nt.x) / 2 - clamp(vel(ball.x) * 0.045, -90, 90) * (1 - retract)
        let nc.y = (nk.y + nt.y) / 2
        //  Thick at the notch, thin where she hangs from it, thinner the longer it is.
        let nr.t = clamp(14 - nt.len / 45, 5.2, 14) * (1 - retract * 0.9)
        let nr.b = 18 * (1 - retract * 0.6)

        //  The thread's points along the curve from the notch to her tip, and how wide it
        //  is at each: thick at the notch, thin where she hangs.
        let tp.0x = (1 - (0/32)) * (1 - (0/32)) * nk.x + 2 * (1 - (0/32)) * (0/32) * nc.x + (0/32) * (0/32) * nt.x
        let tp.0y = (1 - (0/32)) * (1 - (0/32)) * nk.y + 2 * (1 - (0/32)) * (0/32) * nc.y + (0/32) * (0/32) * nt.y
        let tw.0 = 2 * (nr.t + (nr.b - nr.t) * (1 - (0/32)) * (1 - (0/32)) * (1 - (0/32)))
        let tp.1x = (1 - (1/32)) * (1 - (1/32)) * nk.x + 2 * (1 - (1/32)) * (1/32) * nc.x + (1/32) * (1/32) * nt.x
        let tp.1y = (1 - (1/32)) * (1 - (1/32)) * nk.y + 2 * (1 - (1/32)) * (1/32) * nc.y + (1/32) * (1/32) * nt.y
        let tw.1 = 2 * (nr.t + (nr.b - nr.t) * (1 - (1/32)) * (1 - (1/32)) * (1 - (1/32)))
        let tp.2x = (1 - (2/32)) * (1 - (2/32)) * nk.x + 2 * (1 - (2/32)) * (2/32) * nc.x + (2/32) * (2/32) * nt.x
        let tp.2y = (1 - (2/32)) * (1 - (2/32)) * nk.y + 2 * (1 - (2/32)) * (2/32) * nc.y + (2/32) * (2/32) * nt.y
        let tw.2 = 2 * (nr.t + (nr.b - nr.t) * (1 - (2/32)) * (1 - (2/32)) * (1 - (2/32)))
        let tp.3x = (1 - (3/32)) * (1 - (3/32)) * nk.x + 2 * (1 - (3/32)) * (3/32) * nc.x + (3/32) * (3/32) * nt.x
        let tp.3y = (1 - (3/32)) * (1 - (3/32)) * nk.y + 2 * (1 - (3/32)) * (3/32) * nc.y + (3/32) * (3/32) * nt.y
        let tw.3 = 2 * (nr.t + (nr.b - nr.t) * (1 - (3/32)) * (1 - (3/32)) * (1 - (3/32)))
        let tp.4x = (1 - (4/32)) * (1 - (4/32)) * nk.x + 2 * (1 - (4/32)) * (4/32) * nc.x + (4/32) * (4/32) * nt.x
        let tp.4y = (1 - (4/32)) * (1 - (4/32)) * nk.y + 2 * (1 - (4/32)) * (4/32) * nc.y + (4/32) * (4/32) * nt.y
        let tw.4 = 2 * (nr.t + (nr.b - nr.t) * (1 - (4/32)) * (1 - (4/32)) * (1 - (4/32)))
        let tp.5x = (1 - (5/32)) * (1 - (5/32)) * nk.x + 2 * (1 - (5/32)) * (5/32) * nc.x + (5/32) * (5/32) * nt.x
        let tp.5y = (1 - (5/32)) * (1 - (5/32)) * nk.y + 2 * (1 - (5/32)) * (5/32) * nc.y + (5/32) * (5/32) * nt.y
        let tw.5 = 2 * (nr.t + (nr.b - nr.t) * (1 - (5/32)) * (1 - (5/32)) * (1 - (5/32)))
        let tp.6x = (1 - (6/32)) * (1 - (6/32)) * nk.x + 2 * (1 - (6/32)) * (6/32) * nc.x + (6/32) * (6/32) * nt.x
        let tp.6y = (1 - (6/32)) * (1 - (6/32)) * nk.y + 2 * (1 - (6/32)) * (6/32) * nc.y + (6/32) * (6/32) * nt.y
        let tw.6 = 2 * (nr.t + (nr.b - nr.t) * (1 - (6/32)) * (1 - (6/32)) * (1 - (6/32)))
        let tp.7x = (1 - (7/32)) * (1 - (7/32)) * nk.x + 2 * (1 - (7/32)) * (7/32) * nc.x + (7/32) * (7/32) * nt.x
        let tp.7y = (1 - (7/32)) * (1 - (7/32)) * nk.y + 2 * (1 - (7/32)) * (7/32) * nc.y + (7/32) * (7/32) * nt.y
        let tw.7 = 2 * (nr.t + (nr.b - nr.t) * (1 - (7/32)) * (1 - (7/32)) * (1 - (7/32)))
        let tp.8x = (1 - (8/32)) * (1 - (8/32)) * nk.x + 2 * (1 - (8/32)) * (8/32) * nc.x + (8/32) * (8/32) * nt.x
        let tp.8y = (1 - (8/32)) * (1 - (8/32)) * nk.y + 2 * (1 - (8/32)) * (8/32) * nc.y + (8/32) * (8/32) * nt.y
        let tw.8 = 2 * (nr.t + (nr.b - nr.t) * (1 - (8/32)) * (1 - (8/32)) * (1 - (8/32)))
        let tp.9x = (1 - (9/32)) * (1 - (9/32)) * nk.x + 2 * (1 - (9/32)) * (9/32) * nc.x + (9/32) * (9/32) * nt.x
        let tp.9y = (1 - (9/32)) * (1 - (9/32)) * nk.y + 2 * (1 - (9/32)) * (9/32) * nc.y + (9/32) * (9/32) * nt.y
        let tw.9 = 2 * (nr.t + (nr.b - nr.t) * (1 - (9/32)) * (1 - (9/32)) * (1 - (9/32)))
        let tp.10x = (1 - (10/32)) * (1 - (10/32)) * nk.x + 2 * (1 - (10/32)) * (10/32) * nc.x + (10/32) * (10/32) * nt.x
        let tp.10y = (1 - (10/32)) * (1 - (10/32)) * nk.y + 2 * (1 - (10/32)) * (10/32) * nc.y + (10/32) * (10/32) * nt.y
        let tw.10 = 2 * (nr.t + (nr.b - nr.t) * (1 - (10/32)) * (1 - (10/32)) * (1 - (10/32)))
        let tp.11x = (1 - (11/32)) * (1 - (11/32)) * nk.x + 2 * (1 - (11/32)) * (11/32) * nc.x + (11/32) * (11/32) * nt.x
        let tp.11y = (1 - (11/32)) * (1 - (11/32)) * nk.y + 2 * (1 - (11/32)) * (11/32) * nc.y + (11/32) * (11/32) * nt.y
        let tw.11 = 2 * (nr.t + (nr.b - nr.t) * (1 - (11/32)) * (1 - (11/32)) * (1 - (11/32)))
        let tp.12x = (1 - (12/32)) * (1 - (12/32)) * nk.x + 2 * (1 - (12/32)) * (12/32) * nc.x + (12/32) * (12/32) * nt.x
        let tp.12y = (1 - (12/32)) * (1 - (12/32)) * nk.y + 2 * (1 - (12/32)) * (12/32) * nc.y + (12/32) * (12/32) * nt.y
        let tw.12 = 2 * (nr.t + (nr.b - nr.t) * (1 - (12/32)) * (1 - (12/32)) * (1 - (12/32)))
        let tp.13x = (1 - (13/32)) * (1 - (13/32)) * nk.x + 2 * (1 - (13/32)) * (13/32) * nc.x + (13/32) * (13/32) * nt.x
        let tp.13y = (1 - (13/32)) * (1 - (13/32)) * nk.y + 2 * (1 - (13/32)) * (13/32) * nc.y + (13/32) * (13/32) * nt.y
        let tw.13 = 2 * (nr.t + (nr.b - nr.t) * (1 - (13/32)) * (1 - (13/32)) * (1 - (13/32)))
        let tp.14x = (1 - (14/32)) * (1 - (14/32)) * nk.x + 2 * (1 - (14/32)) * (14/32) * nc.x + (14/32) * (14/32) * nt.x
        let tp.14y = (1 - (14/32)) * (1 - (14/32)) * nk.y + 2 * (1 - (14/32)) * (14/32) * nc.y + (14/32) * (14/32) * nt.y
        let tw.14 = 2 * (nr.t + (nr.b - nr.t) * (1 - (14/32)) * (1 - (14/32)) * (1 - (14/32)))
        let tp.15x = (1 - (15/32)) * (1 - (15/32)) * nk.x + 2 * (1 - (15/32)) * (15/32) * nc.x + (15/32) * (15/32) * nt.x
        let tp.15y = (1 - (15/32)) * (1 - (15/32)) * nk.y + 2 * (1 - (15/32)) * (15/32) * nc.y + (15/32) * (15/32) * nt.y
        let tw.15 = 2 * (nr.t + (nr.b - nr.t) * (1 - (15/32)) * (1 - (15/32)) * (1 - (15/32)))
        let tp.16x = (1 - (16/32)) * (1 - (16/32)) * nk.x + 2 * (1 - (16/32)) * (16/32) * nc.x + (16/32) * (16/32) * nt.x
        let tp.16y = (1 - (16/32)) * (1 - (16/32)) * nk.y + 2 * (1 - (16/32)) * (16/32) * nc.y + (16/32) * (16/32) * nt.y
        let tw.16 = 2 * (nr.t + (nr.b - nr.t) * (1 - (16/32)) * (1 - (16/32)) * (1 - (16/32)))
        let tp.17x = (1 - (17/32)) * (1 - (17/32)) * nk.x + 2 * (1 - (17/32)) * (17/32) * nc.x + (17/32) * (17/32) * nt.x
        let tp.17y = (1 - (17/32)) * (1 - (17/32)) * nk.y + 2 * (1 - (17/32)) * (17/32) * nc.y + (17/32) * (17/32) * nt.y
        let tw.17 = 2 * (nr.t + (nr.b - nr.t) * (1 - (17/32)) * (1 - (17/32)) * (1 - (17/32)))
        let tp.18x = (1 - (18/32)) * (1 - (18/32)) * nk.x + 2 * (1 - (18/32)) * (18/32) * nc.x + (18/32) * (18/32) * nt.x
        let tp.18y = (1 - (18/32)) * (1 - (18/32)) * nk.y + 2 * (1 - (18/32)) * (18/32) * nc.y + (18/32) * (18/32) * nt.y
        let tw.18 = 2 * (nr.t + (nr.b - nr.t) * (1 - (18/32)) * (1 - (18/32)) * (1 - (18/32)))
        let tp.19x = (1 - (19/32)) * (1 - (19/32)) * nk.x + 2 * (1 - (19/32)) * (19/32) * nc.x + (19/32) * (19/32) * nt.x
        let tp.19y = (1 - (19/32)) * (1 - (19/32)) * nk.y + 2 * (1 - (19/32)) * (19/32) * nc.y + (19/32) * (19/32) * nt.y
        let tw.19 = 2 * (nr.t + (nr.b - nr.t) * (1 - (19/32)) * (1 - (19/32)) * (1 - (19/32)))
        let tp.20x = (1 - (20/32)) * (1 - (20/32)) * nk.x + 2 * (1 - (20/32)) * (20/32) * nc.x + (20/32) * (20/32) * nt.x
        let tp.20y = (1 - (20/32)) * (1 - (20/32)) * nk.y + 2 * (1 - (20/32)) * (20/32) * nc.y + (20/32) * (20/32) * nt.y
        let tw.20 = 2 * (nr.t + (nr.b - nr.t) * (1 - (20/32)) * (1 - (20/32)) * (1 - (20/32)))
        let tp.21x = (1 - (21/32)) * (1 - (21/32)) * nk.x + 2 * (1 - (21/32)) * (21/32) * nc.x + (21/32) * (21/32) * nt.x
        let tp.21y = (1 - (21/32)) * (1 - (21/32)) * nk.y + 2 * (1 - (21/32)) * (21/32) * nc.y + (21/32) * (21/32) * nt.y
        let tw.21 = 2 * (nr.t + (nr.b - nr.t) * (1 - (21/32)) * (1 - (21/32)) * (1 - (21/32)))
        let tp.22x = (1 - (22/32)) * (1 - (22/32)) * nk.x + 2 * (1 - (22/32)) * (22/32) * nc.x + (22/32) * (22/32) * nt.x
        let tp.22y = (1 - (22/32)) * (1 - (22/32)) * nk.y + 2 * (1 - (22/32)) * (22/32) * nc.y + (22/32) * (22/32) * nt.y
        let tw.22 = 2 * (nr.t + (nr.b - nr.t) * (1 - (22/32)) * (1 - (22/32)) * (1 - (22/32)))
        let tp.23x = (1 - (23/32)) * (1 - (23/32)) * nk.x + 2 * (1 - (23/32)) * (23/32) * nc.x + (23/32) * (23/32) * nt.x
        let tp.23y = (1 - (23/32)) * (1 - (23/32)) * nk.y + 2 * (1 - (23/32)) * (23/32) * nc.y + (23/32) * (23/32) * nt.y
        let tw.23 = 2 * (nr.t + (nr.b - nr.t) * (1 - (23/32)) * (1 - (23/32)) * (1 - (23/32)))
        let tp.24x = (1 - (24/32)) * (1 - (24/32)) * nk.x + 2 * (1 - (24/32)) * (24/32) * nc.x + (24/32) * (24/32) * nt.x
        let tp.24y = (1 - (24/32)) * (1 - (24/32)) * nk.y + 2 * (1 - (24/32)) * (24/32) * nc.y + (24/32) * (24/32) * nt.y
        let tw.24 = 2 * (nr.t + (nr.b - nr.t) * (1 - (24/32)) * (1 - (24/32)) * (1 - (24/32)))
        let tp.25x = (1 - (25/32)) * (1 - (25/32)) * nk.x + 2 * (1 - (25/32)) * (25/32) * nc.x + (25/32) * (25/32) * nt.x
        let tp.25y = (1 - (25/32)) * (1 - (25/32)) * nk.y + 2 * (1 - (25/32)) * (25/32) * nc.y + (25/32) * (25/32) * nt.y
        let tw.25 = 2 * (nr.t + (nr.b - nr.t) * (1 - (25/32)) * (1 - (25/32)) * (1 - (25/32)))
        let tp.26x = (1 - (26/32)) * (1 - (26/32)) * nk.x + 2 * (1 - (26/32)) * (26/32) * nc.x + (26/32) * (26/32) * nt.x
        let tp.26y = (1 - (26/32)) * (1 - (26/32)) * nk.y + 2 * (1 - (26/32)) * (26/32) * nc.y + (26/32) * (26/32) * nt.y
        let tw.26 = 2 * (nr.t + (nr.b - nr.t) * (1 - (26/32)) * (1 - (26/32)) * (1 - (26/32)))
        let tp.27x = (1 - (27/32)) * (1 - (27/32)) * nk.x + 2 * (1 - (27/32)) * (27/32) * nc.x + (27/32) * (27/32) * nt.x
        let tp.27y = (1 - (27/32)) * (1 - (27/32)) * nk.y + 2 * (1 - (27/32)) * (27/32) * nc.y + (27/32) * (27/32) * nt.y
        let tw.27 = 2 * (nr.t + (nr.b - nr.t) * (1 - (27/32)) * (1 - (27/32)) * (1 - (27/32)))
        let tp.28x = (1 - (28/32)) * (1 - (28/32)) * nk.x + 2 * (1 - (28/32)) * (28/32) * nc.x + (28/32) * (28/32) * nt.x
        let tp.28y = (1 - (28/32)) * (1 - (28/32)) * nk.y + 2 * (1 - (28/32)) * (28/32) * nc.y + (28/32) * (28/32) * nt.y
        let tw.28 = 2 * (nr.t + (nr.b - nr.t) * (1 - (28/32)) * (1 - (28/32)) * (1 - (28/32)))
        let tp.29x = (1 - (29/32)) * (1 - (29/32)) * nk.x + 2 * (1 - (29/32)) * (29/32) * nc.x + (29/32) * (29/32) * nt.x
        let tp.29y = (1 - (29/32)) * (1 - (29/32)) * nk.y + 2 * (1 - (29/32)) * (29/32) * nc.y + (29/32) * (29/32) * nt.y
        let tw.29 = 2 * (nr.t + (nr.b - nr.t) * (1 - (29/32)) * (1 - (29/32)) * (1 - (29/32)))
        let tp.30x = (1 - (30/32)) * (1 - (30/32)) * nk.x + 2 * (1 - (30/32)) * (30/32) * nc.x + (30/32) * (30/32) * nt.x
        let tp.30y = (1 - (30/32)) * (1 - (30/32)) * nk.y + 2 * (1 - (30/32)) * (30/32) * nc.y + (30/32) * (30/32) * nt.y
        let tw.30 = 2 * (nr.t + (nr.b - nr.t) * (1 - (30/32)) * (1 - (30/32)) * (1 - (30/32)))
        let tp.31x = (1 - (31/32)) * (1 - (31/32)) * nk.x + 2 * (1 - (31/32)) * (31/32) * nc.x + (31/32) * (31/32) * nt.x
        let tp.31y = (1 - (31/32)) * (1 - (31/32)) * nk.y + 2 * (1 - (31/32)) * (31/32) * nc.y + (31/32) * (31/32) * nt.y
        let tw.31 = 2 * (nr.t + (nr.b - nr.t) * (1 - (31/32)) * (1 - (31/32)) * (1 - (31/32)))
        let tp.32x = (1 - (32/32)) * (1 - (32/32)) * nk.x + 2 * (1 - (32/32)) * (32/32) * nc.x + (32/32) * (32/32) * nt.x
        let tp.32y = (1 - (32/32)) * (1 - (32/32)) * nk.y + 2 * (1 - (32/32)) * (32/32) * nc.y + (32/32) * (32/32) * nt.y
        let tw.32 = 2 * (nr.t + (nr.b - nr.t) * (1 - (32/32)) * (1 - (32/32)) * (1 - (32/32)))

        //  What she answered, under her box (and under the chip when that is below).
        measure jsaid
        let sd.y = if(st.y > 52, st.y + 32, st.y + 70)

        //  A click anywhere else gives the keyboard back to whoever had it. It goes
        //  first: of two zones the later one is on top, and the box's own zones
        //  have to win over it.
        zone box join_away { from: 0, 0; size: stick.width, stick.height; active: join.typing; label: "Outside her box: gives the keyboard back"; role: region }

        //  The box: 410 wide, on the side of her with room for it. `pl.c.l` and
        //  `pl.c.r` are where what is in it begins and ends, clear of her.
        let pl.w = 410
        let pl.side = if(st.x + 25 + pl.w > stick.width - 10, -1, 1)
        let pl.cx = st.x + pl.side * (19 + pl.w * pill / 2)
        let pl.c.l = if(pl.side > 0, st.x + 43, st.x - 19 - pl.w + 20)
        let pl.c.r = if(pl.side > 0, st.x + 19 + pl.w - 14, st.x - 43)
        //  Where she looks: down when she is pulled, at her box when she sits.
        let st.gx = if(join.phase == sitting, pl.side * 3.4 * clamp(pill * 2, 0, 1), clamp(vel(ball.x) * 0.004, -3.5, 3.5))
        let st.gy = if(join.phase == sitting, 0, 3)
        zone box pill_zone { at: pl.cx, st.y; size: pl.w * pill, 36; corner: 18; cursor: text; label: "Tell her what to do in this window"; active: join.phase == sitting and pill > 0.7 and not join.busy }

        //  The windows first, so she is over their edge: the one under her while she
        //  is pulled, and the one she has joined.
        group {
            show: hov.a > 0.01
            opacity: hov.a
            box { at: hov.x - mo.x + hov.w / 2, hov.y - mo.y + hov.h / 2; size: hov.w + 8, hov.h + 8; corner: 18; color: mint; opacity: 9% }
            group {
                glow: 9, 80%, #9ed6bd
                box { at: hov.x - mo.x + hov.w / 2, hov.y - mo.y + hov.h / 2; size: hov.w + 6, hov.h + 6; corner: 17; stroke: 2.4; color: mint }
            }
        }
        group {
            show: join.a > 0.01
            opacity: join.a
            box { at: pb.x - mo.x + pb.w / 2, pb.y - mo.y + pb.h / 2; size: pb.w + 6, pb.h + 6; corner: 17; color: mint; opacity: 4% + 1.5% * join.breath }
            group {
                glow: 8, 55% + 15% * join.breath, #9ed6bd
                box { at: pb.x - mo.x + pb.w / 2, pb.y - mo.y + pb.h / 2; size: pb.w + 6, pb.h + 6; corner: 17; stroke: 2; color: mint; opacity: 80% + 12% * join.breath }
            }
            //  Where she landed, the ring runs out along the edge once.
            box { at: pb.x - mo.x + pb.w / 2, pb.y - mo.y + pb.h / 2
                  size: pb.w + 6 + 90 * join.pu, pb.h + 6 + 90 * join.pu; corner: 17 + 45 * join.pu; stroke: 2.2; color: mint
                  opacity: 70% * (1 - join.pu) * (1 - join.pu) }
        }

        //  Where she touches the window's edge: a soft light on it and a dark point under
        //  her, so she is sitting on it and not floating over it.
        group {
            show: seat > 0.05 and st.ledge > 0.05
            opacity: seat * st.ledge
            ellipse { at: st.x, pb.y - mo.y + 1; radius: 46; scale: 1, 0.12; color: mint; opacity: 34% }
            ellipse { at: st.x, pb.y - mo.y + 3; radius: 21; scale: 1, 0.14; color: #05070a; opacity: 55% }
        }
        //  Her: the water at the notch, the thread, her ball, the foot she has on
        //  the edge and the box that grows from her, one silhouette. A soft halo of
        //  her own mint and a lighter rim, so she reads over a dark window.
        group {
        glow: 7, 42%, #9ed6bd
        body {
            color: skin
            rim: 34%
            glass: glassiness
            lens: bends
            shadow: 0, 4, 16, 36%, #05070a
            ellipse { at: nk.x, nk.y - 8; radius: 21 * (1 - retract * 0.85); scale: 1.4, 0.8; blend: 14 }
            //  The thread: 32 capsules along the curve, each as wide as the middle of its
            //  span; their round ends hide the joins.
            line { from: tp.0x, tp.0y; to: tp.1x, tp.1y; width: (tw.0 + tw.1) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.1x, tp.1y; to: tp.2x, tp.2y; width: (tw.1 + tw.2) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.2x, tp.2y; to: tp.3x, tp.3y; width: (tw.2 + tw.3) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.3x, tp.3y; to: tp.4x, tp.4y; width: (tw.3 + tw.4) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.4x, tp.4y; to: tp.5x, tp.5y; width: (tw.4 + tw.5) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.5x, tp.5y; to: tp.6x, tp.6y; width: (tw.5 + tw.6) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.6x, tp.6y; to: tp.7x, tp.7y; width: (tw.6 + tw.7) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.7x, tp.7y; to: tp.8x, tp.8y; width: (tw.7 + tw.8) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.8x, tp.8y; to: tp.9x, tp.9y; width: (tw.8 + tw.9) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.9x, tp.9y; to: tp.10x, tp.10y; width: (tw.9 + tw.10) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.10x, tp.10y; to: tp.11x, tp.11y; width: (tw.10 + tw.11) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.11x, tp.11y; to: tp.12x, tp.12y; width: (tw.11 + tw.12) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.12x, tp.12y; to: tp.13x, tp.13y; width: (tw.12 + tw.13) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.13x, tp.13y; to: tp.14x, tp.14y; width: (tw.13 + tw.14) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.14x, tp.14y; to: tp.15x, tp.15y; width: (tw.14 + tw.15) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.15x, tp.15y; to: tp.16x, tp.16y; width: (tw.15 + tw.16) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.16x, tp.16y; to: tp.17x, tp.17y; width: (tw.16 + tw.17) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.17x, tp.17y; to: tp.18x, tp.18y; width: (tw.17 + tw.18) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.18x, tp.18y; to: tp.19x, tp.19y; width: (tw.18 + tw.19) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.19x, tp.19y; to: tp.20x, tp.20y; width: (tw.19 + tw.20) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.20x, tp.20y; to: tp.21x, tp.21y; width: (tw.20 + tw.21) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.21x, tp.21y; to: tp.22x, tp.22y; width: (tw.21 + tw.22) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.22x, tp.22y; to: tp.23x, tp.23y; width: (tw.22 + tw.23) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.23x, tp.23y; to: tp.24x, tp.24y; width: (tw.23 + tw.24) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.24x, tp.24y; to: tp.25x, tp.25y; width: (tw.24 + tw.25) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.25x, tp.25y; to: tp.26x, tp.26y; width: (tw.25 + tw.26) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.26x, tp.26y; to: tp.27x, tp.27y; width: (tw.26 + tw.27) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.27x, tp.27y; to: tp.28x, tp.28y; width: (tw.27 + tw.28) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.28x, tp.28y; to: tp.29x, tp.29y; width: (tw.28 + tw.29) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.29x, tp.29y; to: tp.30x, tp.30y; width: (tw.29 + tw.30) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.30x, tp.30y; to: tp.31x, tp.31y; width: (tw.30 + tw.31) / 2; blend: 2; show: retract < 0.97 }
            line { from: tp.31x, tp.31y; to: tp.32x, tp.32y; width: (tw.31 + tw.32) / 2; blend: 2; show: retract < 0.97 }
            ellipse {
                at: st.x, st.y
                radius: 25
                scale: sx * (1 - join.stretch * 0.5), sy * (1 + join.stretch)
                blend: 16
            }
            //  And the box. It comes out of her on the side with room.
            box pill_box {
                at: pl.cx, st.y
                size: pl.w * pill, 36 * clamp(pill * 2.4, 0, 1)
                corner: 18
                blend: 26 * pill * (1 - pill) + 7 * pill
                show: pill > 0.02
            }
        }
        }
        Face(st.x, st.y, st.gx, st.gy, 0)
        //  The drops that go up where she lands, and fall back.
        particles { at: st.x, sit.y + 20 - mo.y; area: 40, 2; count: 28; life: 0.35s .. 0.75s; speed: 90 .. 280
                    direction: -90deg; spread: 140deg; gravity: 0, 720; size: 4.5, 1; colors: #e8f6ff, #9ed6bd; opacity: 95%, 0%
                    shape: dot; burst: join_splash }

        //  What she says under her while she is pulled: the name of the window she
        //  is over, or that it has to be one.
        group {
            show: join.phase == held
            let h.y = st.y + 46
            box { at: st.x, h.y; size: 170, 22; corner: 11; color: #101314; opacity: 88% }
            box { at: st.x, h.y; size: 170, 22; corner: 11; stroke: 1; color: mint; opacity: hov.a * 60% }
            text hov.app { at: st.x, h.y; anchor: center; size: 11.5; weight: 600; color: mint; width: 150; lines: 1; opacity: hov.a }
            text "Drop me on a window" { at: st.x, h.y; anchor: center; size: 11; color: #8b8f95; opacity: 1 - hov.a }
        }

        //  The box. Joined, with the window it is joined to; the task goes in it
        //  and while she works it says what she is doing.
        group {
            opacity: clamp(pill * 3 - 2, 0, 1)
            show: pill > 0.7
            //  Who she is joined to, above the box, and the way out.
            let jc.y = if(st.y > 52, st.y - 38, st.y + 38)
            box { at: pl.cx, jc.y; size: 232, 24; corner: 12; color: #101314; opacity: 90% }
            box { at: pl.cx, jc.y; size: 232, 24; corner: 12; stroke: 1; color: mint; opacity: 30% }
            ellipse { at: pl.cx - 104, jc.y; radius: 3.2; color: mint }
            text "{upper(join.app)}" { at: pl.cx - 96, jc.y; anchor: left center; size: 9.5; weight: 700; color: mint; width: 100; lines: 1 }
            prop letgo.glow = 0 ~140ms
            box { at: pl.cx + 74, jc.y; size: 72, 18; corner: 9; color: #2a2b2c; opacity: 70% + 30% * letgo.glow }
            text "Let go" { at: pl.cx + 74, jc.y; anchor: center; size: 10; weight: 600; color: ink }
            zone box letgo_btn { at: pl.cx + 74, jc.y; size: 72, 18; corner: 9; cursor: pointer; label: "Let go of the window"; active: join.phase == sitting and pill > 0.7 }
            on enter letgo_btn { letgo.glow: 1 }
            on leave letgo_btn { letgo.glow: 0 }
            on press letgo_btn { emit chat_detach }

            //  What she said when she was done: it stays until the next task.
            box { at: pl.cx, sd.y + jsaid.height / 2; size: pl.w - 16, jsaid.height + 18; corner: 14; color: #101314; opacity: 92%; show: join.said_on }
            box { at: pl.cx, sd.y + jsaid.height / 2; size: pl.w - 16, jsaid.height + 18; corner: 14; stroke: 1; color: mint; opacity: 25%; show: join.said_on }
            text join.said { at: pl.cx - pl.w / 2 + 18, sd.y - 6; anchor: left top; width: pl.w - 52; size: 12.5; line_height: 1.35; color: ink; measure: jsaid }
            //  Where she writes. A password never goes through here: it is the
            //  chat's field that turns into one.
            input join.input { at: pl.c.l, st.y - 9; width: pl.c.r - pl.c.l - 40; size: 14; color: ink
                               placeholder: "Tell me what to do in this window…"
                               selection: #2f5f52; show: not join.busy }
            //  And while she works, what she is on.
            text chat.status { at: pl.c.l, st.y; anchor: left center; size: 12.5; color: #b9bcc0; width: pl.c.r - pl.c.l - 40; lines: 1; show: join.busy }
            text chat.status { at: pl.c.l, st.y; anchor: left center; size: 12.5; color: #ef7a66; width: pl.c.r - pl.c.l - 40; lines: 1; show: chat.state == offline }
            prop jsend.glow = 0 ~140ms
            ellipse { at: pl.c.r - 15, st.y; radius: 15; color: mix(mint, #ef7a66, join.busy); opacity: 80% + 20% * jsend.glow }
            path { at: pl.c.r - 21, st.y - 7; color: #0c0f12; stroke: 2; show: not join.busy
                   move 6, 13; line 6, 1 }
            path { at: pl.c.r - 21, st.y - 7; color: #0c0f12; stroke: 2; show: not join.busy
                   move 1, 6; line 6, 1; line 11, 6 }
            box { at: pl.c.r - 15, st.y; size: 10, 10; corner: 2; color: #0c0f12; show: join.busy }
            zone ellipse jsend_btn { at: pl.c.r - 15, st.y; radius: 16; cursor: pointer; label: "Send"; active: join.phase == sitting and pill > 0.7 }
            on enter jsend_btn { jsend.glow: 1 }
            on leave jsend_btn { jsend.glow: 0 }
        }
        //  Her: pressed, she lets go of the window.
        zone ellipse her_perch { at: st.x, st.y; radius: 24; cursor: pointer; label: "Let go of the window"; active: join.phase == sitting and pill > 0.2 }
    }
}
