// Marea's scene, in pieces: the Haven. marea.plm includes it.
part Haven {
    // ── the Haven ────────────────────────────────────────────────
    //  Do not disturb, but awake. «Haven does not mean switched off»: she is
    //  still here, attentive, and keeps the notices while you concentrate.
    //
    //  The membrane shares **exactly** her diameter: entering does not enlarge
    //  her silhouette. Below the waterline the pearls are kept, one per category,
    //  and the tide changes its slope slowly —there and back in 7.6 s— without
    //  moving either the body or the pearls.
    fact haven = false
    fact remaining = 0                 // the minutes she has left
    fact glanced = false               // whether she has already looked at this urgency
    event enter_haven
    event leave_haven
    event view_rules ->
    prop calmness = 0 ~320ms           // 0 awake, 1 in the Haven
    prop glance = 0 ~260ms             // the urgency being looked at, without opening anything
    prop drawing = 0 ~320ms            // the wave the bubble draws, once
    prop summary = 0 ~500ms            // on coming back, a single summary
    //  The tide: there and back in 7.6 s. No nervous loops; this is the only
    //  thing that moves, and it moves like water.
    //  (Only in the Haven: outside it nothing of it is drawn, and a wave that
    //  goes on keeps her making frames nobody sees.)
    pose tide = 0
    wave tide = if(calmness > 0.01, 1, 0) at 0.827
    //  Entering takes 320 ms and waking 500: it is not the same journey, so it is
    //  not the same spring. And the wave the membrane drew is undone on leaving,
    //  in the same time she takes to wake up.
    on enter_haven { haven = true; glanced = false; calmness: 1 ~320ms; drawing: 0 ~16ms; drawing: 1 ~320ms after 30ms }
    on leave_haven { haven = false; remaining = 0; calmness: 0 ~500ms; drawing: 0 ~500ms; summary: 1 ~500ms; summary: 0 ~300ms after 4200ms }
    //  And it ends by itself: one minute less every minute, and on reaching zero
    //  she comes out. A «do not disturb» you have to remember to remove stays on
    //  all afternoon, and then it is no longer a haven but a plug.
    every 60s while haven and remaining > 0 { remaining = remaining - 1 }
    on change remaining while haven and remaining < 1 { emit leave_haven }

    //  «Something urgent has arrived»: the logic says so. The face is alarmed
    //  with an exclamation mark and a short jump; the numbers are those of
    //  Marea's `cupo` gesture, times 46/56.
    event urge
    gesture alarm_jump reflex {
        60ms in_quad   { sx: 1.08; sy: 0.90; body.y: 2.5 }
        130ms out_quad { sx: 0.96; sy: 1.06; body.y: -3.3 }
        110ms in_quad  { sx: 1.02; sy: 0.98 }
        180ms
    }
    fact undoable = false
    fact resolved_row = 0              // which row was resolved, to give it back
    event fuse_out
    pose fuse = 1
    gesture burn state {
        5s linear { fuse: 0 }
        10ms emit fuse_out
    }
    on fuse_out { undoable = false }

    //  An urgent one opens the tray without taking the keyboard, and the face is
    //  alarmed: an exclamation mark and a short jump. **Once per episode**, from
    //  the first one until none is left: a notice that jumps every time is a
    //  notice that ends up covered with a window.
    //  The exclamation mark is a REACTION, not a state: it lasts as long as the
    //  fright lasts and goes. What stays «while it lasts» is the amber drop on
    //  her shoulder, which is what it rises for. Before, the face stayed alarmed
    //  until no urgent one was left, and since an unresolved urgent one does not
    //  go away by itself, she kept the «!» on all afternoon.
    //
    //  And «once per episode» can no longer hang from the face, because the face
    //  comes back: its own fact carries it, which is cleared when none is left.
    fact alarmed = false
    //  Quiet: a notice that arrives with `hush` on goes straight to its drop,
    //  as in the Haven —no card, no jump, no tray opening by itself—. The
    //  logic says it for each one: «do not disturb» (which an urgent one gets
    //  through), a recording going on, or the screen locked.
    fact hush = false
    fact dnd = false                   // do not disturb, from Settings or the finder
    fact quiet_rec = true              // and quiet while recording the screen
    fact snooze_k = 1                  // «later» is 0: 15 min · 1: an hour · 2: three hours
    //  The screen being shared (pleamar-wm's portal says so): a coral ring
    //  breathes around her the whole time, and notices come in quietly.
    fact sharing = false
    event sharing_on ->
    event sharing_off ->
    on sharing_on { sharing = true }
    on sharing_off { sharing = false }
    prop share.lit = 0 ~400ms
    follow share.lit = if(sharing, 1, 0)
    prop share.breath = 0
    spin share.breath by if(sharing, 0.3, 0)
    model muted max 6 { app: text }    // the apps whose notices go straight to the history
    event flip_dnd
    event flip_quiet_rec
    event unmute ->
    on flip_dnd { toggle dnd }
    on flip_quiet_rec { toggle quiet_rec }
    on urge while not haven and not hush and not alarmed { alarmed = true; face = alert; sign: 0 ~100ms; play alarm_jump; filter = 0; tray_by_itself = true; emit open_tray }
    on still face for 1.6s while face == alert { face = eye }
    //  In the Haven an allowed urgency **does not open the tray or steal the
    //  focus**: an amber pearl appears over the membrane and only the eye beside
    //  it turns round to look at it. 1.1 s, and back to her own business.
    //  Once per episode, just like the alarmed face: what bothers about an
    //  urgent notice is not the first one, it is the fourth.
    on urge while (haven or hush) and not glanced { glanced = true; glance: 1; glance: 0 ~260ms after 840ms }
    on still any_urgent for 1.6s while not any_urgent { glanced = false; alarmed = false }
    //  What each row is about. The logic would set it; here it is born with something.
    prop tray = 0 ~240ms               // 0 inside her, 1 whole card
    prop lane = 0 ~240ms               // the drops: 0 on her shoulder, 1 in the lane
    //  Each row arrives a little after the one above: that is the swell.
    //  And on resolving it, it goes off to the right and releases a drop that
    //  comes back.
    repeat k in 1..6 {
        fact alive.$k = true
        fact row_cat.$k = 1
        //  An urgent one is not grouped: its own row, at the top and in amber.
        fact row_urgent.$k = false
        prop rise.$k = 0 ~lively
        prop flung.$k = 0 ~220ms
        prop freed.$k = 0 ~380ms
        //  How far the finger has dragged it. If it does not reach the threshold,
        //  it goes back by itself.
        prop pull.$k = 0 ~lively
        prop touch.$k = 0 ~140ms
        //  How many live ones it has above: its place in the list. On resolving
        //  one, the ones below rise to fill the gap instead of leaving it there.
        prop above.$k = 0 ~calm
    }
    //  Which rows show: the live ones, and if there is a filter only its own.
    //  It goes in a one-frame spring because a `let` does not see the facts of
    //  a `repeat`.
    repeat k in 1..6 {
        prop visible.$k = 0 ~16ms
        follow visible.$k = if(alive.$k and (filter < 0.5 or row_cat.$k == filter), 1, 0)
    }
    follow above.1 = if(visible.2 > 0.5 and row_urgent.2 and not row_urgent.1, 1, 0) + if(visible.3 > 0.5 and row_urgent.3 and not row_urgent.1, 1, 0) + if(visible.4 > 0.5 and row_urgent.4 and not row_urgent.1, 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.1, 1, 0)
    follow above.2 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.2), 1, 0) + if(visible.3 > 0.5 and row_urgent.3 and not row_urgent.2, 1, 0) + if(visible.4 > 0.5 and row_urgent.4 and not row_urgent.2, 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.2, 1, 0)
    follow above.3 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.3), 1, 0) + if(visible.2 > 0.5 and (row_urgent.2 or not row_urgent.3), 1, 0) + if(visible.4 > 0.5 and row_urgent.4 and not row_urgent.3, 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.3, 1, 0)
    follow above.4 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.4), 1, 0) + if(visible.2 > 0.5 and (row_urgent.2 or not row_urgent.4), 1, 0) + if(visible.3 > 0.5 and (row_urgent.3 or not row_urgent.4), 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.4, 1, 0)
    follow above.5 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.5), 1, 0) + if(visible.2 > 0.5 and (row_urgent.2 or not row_urgent.5), 1, 0) + if(visible.3 > 0.5 and (row_urgent.3 or not row_urgent.5), 1, 0) + if(visible.4 > 0.5 and (row_urgent.4 or not row_urgent.5), 1, 0)
    follow any_urgent = if(alive.1 and row_urgent.1, 1, 0) + if(alive.2 and row_urgent.2, 1, 0) + if(alive.3 and row_urgent.3, 1, 0) + if(alive.4 and row_urgent.4, 1, 0) + if(alive.5 and row_urgent.5, 1, 0)
    //  Which category the live urgent one belongs to: it is what makes ITS drop
    //  rise to shoulder height and turn amber while it lasts. It goes in props
    //  because a `let` does not see the facts a `repeat` declares.
    repeat k in 1..5 {
        prop cat_urgent.$k = 0 ~16ms
        follow cat_urgent.$k = clamp(if(alive.1 and row_urgent.1 and row_cat.1 == k, 1, 0) + if(alive.2 and row_urgent.2 and row_cat.2 == k, 1, 0) + if(alive.3 and row_urgent.3 and row_cat.3 == k, 1, 0) + if(alive.4 and row_urgent.4 and row_cat.4 == k, 1, 0) + if(alive.5 and row_urgent.5 and row_cat.5 == k, 1, 0), 0, 1)
    }
    prop cat_urgent.any = 0 ~16ms
    follow cat_urgent.any = cat_urgent.1 + cat_urgent.2 + cat_urgent.3 + cat_urgent.4
    fact row_cat.2 = 3
    fact row_cat.3 = 2
    fact row_cat.4 = 4
    fact row_cat.5 = 1
    text row.1.app = "TELEGRAM"
    text row.2.app = "CALENDAR"
    text row.3.app = "MAIL"
    text row.4.app = "SYSTEM"
    text row.5.app = "TELEGRAM"
    text row.1.title = "Ana Ruiz"
    text row.2.title = "Design review"
    text row.3.title = "September invoice"
    text row.4.title = "Backup done"
    text row.5.title = "Building site group"
    text row.1.detail = "Lunch today? I have a table at two"
    text row.2.detail = "in 10 minutes · big room"
    text row.3.detail = "due on the 30th"
    text row.4.detail = "412 files, 2.1 GB"
    text row.5.detail = "6 unread messages"
    text row.1.age = "now"
    text row.2.age = "2 min"
    text row.3.age = "1 h"
    text row.4.age = "3 h"
    text row.5.age = "yesterday"
    prop arrive = 0 ~220ms             // the card, coming in
    //  The arriving card's life, beat by beat: the drop falling from the top
    //  edge and unfolding (land), its words being written (write), how much of
    //  its reading has gone (read.t, which the pointer stops), the chips that
    //  come out under the pointer, the symbol in her eyes, and the pile opening.
    prop land = 0 ~16ms
    prop write = 0 ~16ms
    prop read.t = 0
    spin read.t by if(phase == 1 and not hovered and land > 0.95, 1 / if(burst > 1, 4.2, 3.2), 0)
    prop chips = 0 ~180ms
    follow chips = if(hovered and phase == 1, 1, 0)
    prop sign = 0 ~200ms
    prop pile.open = 0 ~gentle
    follow pile.open = if(hovered and burst > 1 and phase == 1, 1, 0)
    prop urgent.beat = 0
    spin urgent.beat by if(reading_urgent and phase == 1, 1.2, 0)
    fact reading_urgent = false
    fact acts = 0
    fact notice.icon = false
    text act.1 = ""
    text act.2 = ""
    model notice_face max 1 { icon: image 24, 24 }
    event notice_act ->                // a chip of the arriving card: 0 open, 1 done, 2 and 3 its own, 9 the whole pile
    event notice_puff                  // the one in front, done: it vanishes in a puff
    event notice_gone                  // all of them done: the card goes without flying to any count
    //  One per card in the pile: they fly together but not at the same time.
    repeat j in 0..3 { prop fly.$j = 0 ~280ms }
    prop attentive = 0 ~gentle         // looking at the card
    follow attentive = if(phase == 1, 1, 0)

    let blue = #6fb1e6
    let lilac = #a68be4
    let green = #8fd1ae
    let amber = #e3a35c
    //  How many there are of each, and when the last one arrived: they are
    //  declared before the drops because each drop looks at the other three.
    repeat k in 1..5 {
        fact n.$k = 0
        fact last.$k = 0
        //  The drop beats when something of its own falls, and in the Haven its
        //  pearl beats: it is the same blow, because it is the same news told
        //  somewhere else.
        prop beat.$k = 0 ~lively
        //  And the pearl, which appears when something of its category is kept.
        prop pearl.$k = 0 ~320ms
        follow pearl.$k = if(n.$k > 0, 1, 0)
    }
    //  Whether any urgent one is left. While there is, the face stays alarmed.
    prop any_urgent = 0 ~16ms

    //  How many are waiting, of all categories: it is what decides whether
    //  hovering over her brings out the time or the fan. It goes in a `prop`
    //  because a `let` does not see the facts a `repeat` declares —it is
    //  resolved earlier—, and with a one-frame spring so it does not drag.
    prop pending = 0 ~16ms
    follow pending = n.1 + n.2 + n.3 + n.4

    //  The preview. With pending notices, hovering over her opens the drops in a
    //  fan below her, with their category's icon, and shows the most recent one.
    //  **It takes the place of the time note**: either one, or the other.
    prop fan = 0 ~160ms

    //  The time note.
    fact note = false
    event calendar ->                  // a click on it: the logic opens the calendar
    //  What the card asks of the logic. There is no logic here, so they stay
    //  said: the boundary is written, which is what matters.
    event mute_output ->
    event mute_mic ->
    //  And the keyboard's own keys, from the compositor (`marea volume_up`…).
    event volume_up ->
    event volume_down ->
    event bright_up ->
    event bright_down ->
    event play_pause ->
    event previous ->
    event next ->
    event settings ->
    event flip ->                      // with which of the three, as payload
    //  Dragging a level sends WHERE the finger has gone, from 0 to 1. Two events
    //  and not one with the track as payload, because a payload is a number and
    //  here two things are needed: which one and how much.
    event set_brightness ->
    event set_volume ->
    event set_mic ->                   // the microphone's level, 0..1
    event set_rain ->                  // how hard it rains on the windows, 0..1
    event open_page ->                 // with which of the six, as payload
    //  The calendar: 42 days in the grid (six weeks, Monday first), what the
    //  logic says of each one, and the chosen day's events.
    event cal_pick ->                  // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_delete ->                // an event of the chosen day, by its row
    event cal_went_prev
    event cal_went_next
    event cal_added
    event cal_splash
    fact cal.sel = 0                   // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_day = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""
    text city_q = ""
    model cal_events max 6 { time: text; title: text }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 {
        text cal.wd.$w = ""
    }
    //  The agents' reservoirs: two agents (1 Claude Code, 2 Codex; 0 none), up
    //  to three windows each. The logic reads them; the scene draws them.
    event agents_refresh ->
    event agents_read
    fact ag.worst = 101                // the least left of the active windows, in %; 101, unknown
    //  Her face on opening the page: first she reads the water, then says
    //  what she thinks of it.
    fact agents.face: none | reading | verdict = none
    let ag.shown = if(ag.worst > 100, 0.5, ag.worst / 100)
    let ag.tone = mix(mix(mix(#ef7a66, #f0b85a, clamp((ag.worst - 12) / 8, 0, 1)), mint, clamp((ag.worst - 40) / 15, 0, 1)), #8b8f95, ag.worst > 100)
    repeat a in 1..3 {
        fact ag.kind.$a = 0
        text ag.name.$a = ""
        text ag.sub.$a = ""
        repeat l in 1..4 {
            fact ag.on.$a.$l = false
            fact ag.active.$a.$l = false
            fact ag.pending.$a.$l = false
            fact ag.used.$a.$l = -1
            fact ag.elapsed.$a.$l = 0
            text ag.lname.$a.$l = ""
            text ag.lrenew.$a.$l = ""
        }
    }
    repeat k in 1..7 {
        fact switched_on.$k = false
        prop lit.$k = 0 ~180ms
        follow lit.$k = if(switched_on.$k, 1, 0)
    }
    //  And the first one is lit by the network, not by a fact someone has to set.
    follow lit.1 = if(net.online, 1, 0)
    //  And the third one is lit by the Haven: the card does not keep its own
    //  switch, it shows the one there already is. Two truths of the same state
    //  is how you end up with a card switched on and the ball awake.
    follow lit.3 = if(haven, 1, 0)
    prop notecard = 0 ~650ms
    //  And with the menu out neither of the two comes out: they take its place.
    //  Going out it takes its time —it is a division, see below— and it goes
    //  back in quickly: two rules, because the two journeys are not the same.
    //  With notices waiting too: the fan opens below her and the time beside
    //  her. It used to be one or the other, and with notices the time was
    //  never seen.
    let notecard.wants = note and not open and not haven and not menu_open and face == eye and out > 0.9 and phase == 0
    on change notecard.wants while notecard.wants { notecard: 1 ~700ms }
    on change notecard.wants while not notecard.wants { notecard: 0 ~260ms }
    follow fan = if(note and not open and not tray_open and not haven and not menu_open and face == eye and out > 0.9 and phase == 0 and pending > 0, 1, 0)
}
