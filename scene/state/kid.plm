// Marea's scene, in pieces: where her children are, seen from her. marea.plm includes it.
part KidState {
    // ── her and her children ─────────────────────────────────────
    //  Her place in desktop pixels: each thread is fixed on it, and a child that goes home goes there.
    let hm.dx = host.x + (host.w - 920) / 2 + cx
    let hm.dy = host.y + cy_actual
    //  How much she looks at them and which way (the children's looks and directions, as the rules
    //  work them out: scene/rules/join.plm): towards the one that is out; with several, between
    //  them, and straight on when they are on opposite sides.
    prop kid.look = 0 ~gentle
    follow kid.look = max(max(ch.0.look, ch.1.look), max(ch.2.look, ch.3.look))
    prop kid.dirx = 0 ~gentle
    prop kid.diry = 0 ~gentle
    follow kid.dirx = (ch.0.look * ch.0.dirx + ch.1.look * ch.1.dirx + ch.2.look * ch.2.dirx + ch.3.look * ch.3.dirx) / max(ch.0.look + ch.1.look + ch.2.look + ch.3.look, 1)
    follow kid.diry = (ch.0.look * ch.0.diry + ch.1.look * ch.1.diry + ch.2.look * ch.2.diry + ch.3.look * ch.3.diry) / max(ch.0.look + ch.1.look + ch.2.look + ch.3.look, 1)
    //  The word at her side when she has four already, or the window has one: how formed it is.
    prop kid.note = 0 ~spring(170, 15)
    follow kid.note = if(kid.warn != none, 1, 0)
}
