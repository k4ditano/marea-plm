// Marea's scene, in pieces: the perch, her joining one window. marea.plm includes it.
part Join {
    // ── the perch: she is dropped on a window and joins it ───────
    //  You grab her and pull: she stretches a thread of her own water down
    //  from where she lives, with herself at the end of it, following the
    //  pointer. Let go on empty desktop and the thread draws her back in. Let go
    //  over a window and she falls onto it, the thread snaps and flies back
    //  up, and she sits on its top edge: from then on she has that window and
    //  only that one (logic/chat.luau, `chat_attach`), and what you write in the
    //  box that grows out of her is the task.
    //
    //  All of it happens in a surface the size of the monitor (scene/surfaces/
    //  join.plm), and in DESKTOP coordinates: a window's box, the pointer and
    //  the notch are all measured from the top left of the first monitor, and
    //  each copy of the surface takes off its own monitor's corner. The logic
    //  says where the monitors are and where the windows are (pleamar-wm's
    //  `agent monitors` and `agent windows`): the scene never asks.
    //
    //  none · held (pulling her) · waiting (let go, the logic is looking for the
    //  window under her) · falling (on her way to its edge, up or down) ·
    //  sitting (on it) · leaving (back up into the water)
    fact join.phase: none | held | waiting | falling | sitting | leaving = none
    //  Where the monitors are, in desktop pixels. Three copies at most.
    fact mon.x.0 = 0
    fact mon.y.0 = 0
    fact mon.w.0 = 1920
    fact mon.x.1 = 1920
    fact mon.y.1 = 0
    fact mon.w.1 = 1920
    fact mon.x.2 = 3840
    fact mon.y.2 = 0
    fact mon.w.2 = 1920
    //  Her place at the top: the thread starts from here (desktop pixels).
    fact anc.x = 960
    fact anc.y = 0
    //  The pointer while she is pulled, in desktop pixels; the logic reads it to
    //  find the window under her.
    fact ptr.x = 0
    fact ptr.y = 0
    //  The window under her while she is pulled: it lights up and says its name.
    fact hov.on = false
    fact hov.x = 0
    fact hov.y = 0
    fact hov.w = 0
    fact hov.h = 0
    text hov.app = ""
    //  The window she is joined to (or is falling onto), kept up to date by the
    //  logic while she sits on it: its box in desktop pixels, the monitor it is
    //  on, and where along its top edge she sits.
    fact join.x = 0
    fact join.y = 0
    fact join.w = 0
    fact join.h = 0
    fact join.screen = 0
    fact join.dx = 60
    text join.app = ""
    text join.said = ""               // the last thing she answered, short
    fact join.said_on = false          // and whether there is one to show
    //  Where what you write in the box goes: the logic copies it into the
    //  chat's own input and sends it.
    text join.input = ""
    //  The box is there to be written in (grown, she sits, the chat is not in its place):
    //  a click in it gives it the keyboard, as any field.
    let join.shown = join.phase == sitting and pill > 0.5
    fact join.typing = false          // the box holds the keyboard
    event join_grab ->                // she has been pulled out: look at the windows
    event join_drop ->                // let go: which window is she over?
    event join_send ->                // Enter in the box
    event join_land                   // the logic found it: fall onto join.x…
    event join_none                   // nothing under her
    event join_splash                 // the drops thrown up where she lands

    // ── what moves ───────────────────────────────────────────────
    //  Her ball, in desktop pixels. While she is pulled it follows the pointer
    //  with a spring, so the thread has something to stretch against.
    prop ball.x = 960 ~lively
    prop ball.y = 46 ~lively
    //  A loose spring for the fall: underdamped, it reaches the window at its
    //  fastest and is cut there, which is what a fall is.
    spring plunge = 34, 3.4
    //  How far the thread has gone back into the water: 0 she is on it, 1 gone.
    prop retract = 1 ~quick
    //  She is sitting: 0 she is where `ball` says, 1 where the window says.
    prop seat = 0 ~110ms
    //  The window's box, followed with a spring: she is carried by it, a little
    //  behind, as water would.
    prop pb.x = 0 ~70ms
    prop pb.y = 0 ~70ms
    prop pb.w = 0 ~70ms
    prop pb.h = 0 ~70ms
    //  While the window she sits on is carried by its title bar, the logic says so (`carry.on`,
    //  and where it was taken: `carry.gx`, `carry.gy`, from the window's corner) and the scene
    //  follows the mouse itself, every frame: the logic's numbers come a few times a second.
    //  The window manager tells when one starts to be carried and when it is let go
    //  (pleamar-wm 0.6.2: `emit carry_start`, `emit carry_end`): hers is the one whose title bar
    //  the mouse is on at that moment.
    event carry_start
    event carry_end
    //  She asks the logic for where it was taken, exactly (`grab` of the window manager).
    event carry_grab
    //  Where the mouse was a moment before the window manager said a window was being carried:
    //  the mouse a little late, which is about where it took the window.
    prop cl.x = 0 ~55ms
    prop cl.y = 0 ~55ms
    follow cl.x = cur.dx
    follow cl.y = cur.dy
    //  Her window is not shown (another workspace, minimised): she is not either.
    fact join.hidden = false
    fact carry.on = false
    fact carry.gx = 0
    fact carry.gy = 0
    follow pb.x = jx
    follow pb.y = jy
    follow pb.w = join.w
    follow pb.h = join.h
    //  The box that grows out of her once she is sitting.
    prop pill = 0 ~spring(190, 17)
    //  How lit the window under her is while she is pulled, and the ring of
    //  the one she is joined to.
    prop hov.a = 0 ~140ms
    follow hov.a = if(hov.on and join.phase == held, 1, 0)
    prop join.a = 0 ~320ms
    follow join.a = if(join.phase == sitting or join.phase == falling, 1, 0)
    //  The wave that runs out along the window's edge when she lands.
    prop pulse = 1 ~900ms
    //  And the slow breath of the ring on the window she is joined to (join surface).
    prop join.breath = 0
    //  She is chewing on a task (the box says what).
    let join.busy = chat.state == thinking or chat.state == acting or chat.state == awaiting or chat.state == starting
    //  Which monitor she lives on, for the notch.
    let host.i = if(hosts.2, 2, if(hosts.1, 1, 0))
    let host.x = pick(host.i, mon.x.0, mon.x.1, mon.x.2)
    let host.y = pick(host.i, mon.y.0, mon.y.1, mon.y.2)
    let host.w = pick(host.i, mon.w.0, mon.w.1, mon.w.2)
    let cur.dx = host.x + (host.w - 920) / 2 + cursor.x
    let cur.dy = host.y + cursor.y
    let jx = if(carry.on and join.screen == host.i, cur.dx - carry.gx, join.x)
    let jy = if(carry.on and join.screen == host.i, cur.dy - carry.gy, join.y)
    //  Where she lands: along the top edge of the window, where she was let go,
    //  and a little over it, sunk 6 px, like a drop on a ledge; and if the window
    //  is up against the top of its monitor there is no ledge above it, so she
    //  sits astride the edge as high as her own body allows.
    let sit.mx = pick(join.screen, mon.x.0, mon.x.1, mon.x.2)
    let sit.my = pick(join.screen, mon.y.0, mon.y.1, mon.y.2)
    let sit.x = pb.x + clamp(join.dx, 34, max(pb.w - 34, 34))
    let sit.y = sit.my + max(pb.y - sit.my - 17, 14)
    //  The same place from the logic's own numbers, for sending her there: the
    //  window's box springs (`pb`) and has not arrived yet when she is sent.
    let tgt.x = jx + clamp(join.dx, 34, max(join.w - 34, 34))
    let tgt.y = sit.my + max(jy - sit.my - 17, 14)
    //  Let go inside a window she is BELOW its top edge, so she goes up to it (a
    //  drop drawn along the glass); told from the keyboard she starts above it and
    //  falls. `join.up` says which, when she is sent.
    fact join.up = false
    //  She reaches the ledge: the moment the thread breaks.
    let join.hit = if(join.up, ball.y < sit.y + 2, ball.y > sit.y - 1.5)
    //  And it is how fast she falls that stretches her, as in the journey.
    let join.stretch = clamp(vel(ball.y) * 0.00028, 0, 0.3)

    // ── the grab ─────────────────────────────────────────────────
    //  Pressing her is a click; pulling her is this. `dragged` tells the two
    //  apart on letting go.
    fact dragged = false
    //  She can be pulled when nothing of hers is open and she is not away.
    let join.can = join.phase == none and not open and not chatting and not searching and not tray_open and not menu_open and not haven and not adventuring and not celebrating and not corner and not chat.attached and away < 0.05 and offset < 0.05
}
