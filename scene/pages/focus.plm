// Marea's scene, in pieces: focus. marea.plm includes it.
part Focus {
    //  Focus: a dial of up to two hours. Dragged round, or with the
    //  wheel, it says how long; three usual lengths beside it, and when
    //  it would end. While it is on, the dial is what is left, and the
    //  button ends it. What it does is said below, and how much of
    //  today has been spent in it.
    group {
        show: page == concentration
        let dial.cx = card.x - 112
        let dial.cy = card.top + 236
        let on = if(haven, 1, 0)
        let shown = mix(focus.mins, remaining, on)
        let frac = clamp(mix(focus.mins / 120, remaining / max(1, focus.total), on), 0, 1)
        prop dial.glow = 0 ~140ms
        ellipse { at: dial.cx, dial.cy; radius: 92; color: #1c1d1e }
        ellipse { at: dial.cx, dial.cy; radius: 78; stroke: 10; color: #262728 }
        //  The ticks: one every quarter of an hour, the hours longer.
        repeat t in 0..8 {
            line { from: dial.cx + 64 * sin(t * 45), dial.cy - 64 * cos(t * 45)
                   to: dial.cx + (if(t == 0 or t == 4, 56, 60)) * sin(t * 45), dial.cy - (if(t == 0 or t == 4, 56, 60)) * cos(t * 45)
                   width: 1.5; color: #8b8f95; opacity: 60% }
        }
        arc { at: dial.cx, dial.cy; radius: 78; span: frac * 360deg; width: 10; rotate: frac * 180deg; color: mix(mint, #8ff0cc, dial.glow * (1 - on)) }
        //  The knob, at the end of what is chosen.
        ellipse { at: dial.cx + 78 * sin(frac * 360), dial.cy - 78 * cos(frac * 360); radius: 9 + 2 * dial.glow; color: #f0ece4; show: not haven }
        //  The moon, and how long, large.
        path { at: dial.cx - 10, dial.cy - 54; color: mix(ink, mint, on); opacity: 80%
               move 8.3, 2.4; curve 3.5, 6.1 via 5.2, 3.4; curve 2, 11.9 via 1.7, 8.7; curve 4.6, 17.4 via 2.4, 15.1
               curve 10.1, 20 via 6.9, 19.6; curve 15.9, 18.5 via 13.3, 20.3; curve 19.6, 13.7 via 18.6, 16.8
               curve 14.5, 14.4 via 17.2, 14.8; curve 10, 12 via 11.9, 13.9; curve 7.6, 7.5 via 8.1, 10.1
               curve 8.3, 2.4 via 7.2, 4.8; close }
        text "{shown, 0}" { at: dial.cx, dial.cy + 2; anchor: center; size: 34; weight: 600; color: ink }
        text pick(haven, "minutes", "minutes left") { at: dial.cx, dial.cy + 28; anchor: center; size: 11; color: #8b8f95 }
        text focus.until { at: dial.cx, dial.cy + 46; anchor: center; size: 10.5; color: mint; opacity: 85% }
        zone ellipse dial { at: dial.cx, dial.cy; radius: 96; cursor: pointer; active: page == concentration and paging > 0.9 and not haven }
        on enter dial { dial.glow: 1 }
        on leave dial { dial.glow: 0 }
        //  Round the dial: where the finger is, from the top and clockwise,
        //  in steps of five minutes; never less than five.
        on press dial { focus.mins = max(5, floor(fract((atan2(pointer.y - (card.top + 236), pointer.x - (card.x - 112)) + 90) / 360) * 24 + 0.5) * 5) }
        on drag dial { focus.mins = max(5, floor(fract((atan2(pointer.y - (card.top + 236), pointer.x - (card.x - 112)) + 90) / 360) * 24 + 0.5) * 5) }
        on scroll dial { focus.mins = clamp(focus.mins + wheel * 5, 5, 120) }

        //  The right column: the usual lengths, the button, and what it does.
        let focus.rx = card.x + 18
        text pick(haven, "How long?", "Focusing") { at: focus.rx, card.top + 128; anchor: left center; size: 14; weight: 600; color: ink }
        repeat m in 0..3 {
            let mins = 25 + m * 20
            let chosen = if(focus.mins == mins and not haven, 1, 0)
            prop len.glow.$m = 0 ~140ms
            box { from: focus.rx + m * 70, card.top + 146; size: 64, 32; corner: 10
                  color: mix(mix(#202021, #2a2b2c, len.glow.$m), #1a241f, chosen); opacity: if(haven, 40%, 100%) }
            box { from: focus.rx + m * 70, card.top + 146; size: 64, 32; corner: 10; stroke: 1.2; color: mint; opacity: chosen * 60% }
            text "{mins} min" { at: focus.rx + m * 70 + 32, card.top + 162; anchor: center; size: 11.5; weight: 500; color: mix(ink, mint, chosen); opacity: if(haven, 40%, 100%) }
            zone box len.$m { from: focus.rx + m * 70, card.top + 146; size: 64, 32; corner: 10; cursor: pointer; active: page == concentration and paging > 0.9 and not haven }
            on enter len.$m { len.glow.$m: 1 }
            on leave len.$m { len.glow.$m: 0 }
            on press len.$m { focus.mins = mins }
        }
        prop go.glow = 0 ~140ms
        box { from: focus.rx, card.top + 192; size: 204, 38; corner: 12
              color: mix(mix(mint, #8ff0cc, go.glow), mix(#3a2626, #4a2d2d, go.glow), on) }
        text pick(haven, "Start", "End now") { at: focus.rx + 102, card.top + 211; anchor: center; size: 13; weight: 600; color: mix(#0c0f12, #f0b0a8, on) }
        zone box go { from: focus.rx, card.top + 192; size: 204, 38; corner: 12; cursor: pointer; active: page == concentration and paging > 0.9 }
        on enter go { go.glow: 1 }
        on leave go { go.glow: 0 }
        //  And here is where the Haven is entered: the first thing it does
        //  is close. Leaving the panel open on top of her would be the
        //  opposite of what you have just asked for.
        on press go while not haven { remaining = focus.mins; focus.total = focus.mins; page = none; open = false; emit enter_haven }
        on press go while haven { emit leave_haven }
        //  What it does, three lines with their marks.
        repeat w in 0..3 {
            let wy = card.top + 256 + w * 24
            ellipse { at: focus.rx + 8, wy; radius: 3; color: mint; opacity: 70% }
            text pick(w, "Notices are kept, not shown", "She curls up in her haven", "She comes back when time is up") { at: focus.rx + 20, wy; anchor: left center; size: 11; width: 200; lines: 1; color: #b9bcc0 }
        }
        text focus.today { at: focus.rx, card.top + 338; anchor: left center; size: 11; weight: 500; color: mint; width: 210; lines: 1 }
    }
}
