// Marea's scene, in pieces: what is seen of the chat. marea.plm includes it.
part Chat {
    // ── what is seen of the chat ─────────────────────────────────
    //  A row of the thread. Yours, a bubble on the right, as wide as it says;
    //  hers, loose on the water, the letters of the one arriving rising out of
    //  it as they come; what she used, a small line with its mark; and a card
    //  that asks you, in amber, beating, with its two answers.
    component ChatRow(r: record) {
        measure said
        measure hers
        measure asked
        size: 556, if(r.kind == 1, said.height + 18, if(r.kind == 2, hers.height + 6, if(r.kind == 4, asked.height + 74, 26)))
        prop allow.glow = 0 ~140ms
        prop deny.glow = 0 ~140ms
        let arriving = r.index == chat.live
        //  The newest falls in (see `chat.drop`).
        let fresh = if(r.index == chat.rows.count - 1, clamp(chat.drop, 0, 1.2), 1)
        group {
        opacity: clamp(fresh * 1.6, 0, 1)
        move: 0, (1 - min(fresh, 1)) * -18
        pivot: 278, 12
        scale: 1 + (fresh - 1) * 0.35, 1 - (fresh - 1) * 0.5
        //  The ring where it lands: something she used, or a card.
        ellipse { at: if(r.kind == 4, 16, 10), 13; radius: 5 + 22 * min(fresh, 1); stroke: 1.4; color: if(r.kind == 4, amber, mint)
                  opacity: 60% * (1 - min(fresh, 1)); show: r.kind == 3 or r.kind == 4 }
        //  1 · yours
        group {
            show: r.kind == 1
            body {
                color: #1d2b27
                rim: 10%
                box { from: 556 - said.width - 26, 0; size: said.width + 26, said.height + 14; corner: 14 }
            }
            text r.text { at: 556 - 13, 7; anchor: right top; width: 420; size: 13; color: ink; align: right; measure: said; selectable: true; selection: #3d6b5e }
        }
        //  2 · hers: as each letter arrives it fades in and rises the last
        //  few pixels, a ripple running along the newest ones.
        text r.text { at: 2, 2; anchor: left top; width: 520; size: 13.5; line_height: 1.4; color: ink; measure: hers; show: r.kind == 2; markdown: true
                      selectable: true; selection: #2f5a50
                      letter_opacity: if(arriving, clamp((chat.reveal - letter) / 12, 0, 1), 1)
                      letter_move: 0, if(arriving, (1 - clamp((chat.reveal - letter) / 12, 0, 1)) * 7, 0) }
        //  3 · something she used: a drop that fills while it goes, a tick, a
        //  cross or a dash after.
        group {
            show: r.kind == 3
            ellipse { at: 10, 13; radius: 5.5; stroke: 1.4; color: mix(mix(mint, #ef7a66, r.state == 2), #8b8f95, r.state == 3) }
            arc { at: 10, 13; radius: 5.5; span: 110deg; width: 1.6; rotate: chat.t * 360deg; color: mint; show: r.state == 0 }
            ellipse { at: 10, 13; radius: 3; color: mint; show: r.state == 1 }
            text r.text { at: 24, 13; anchor: left center; size: 11.5; color: #b9bcc0; width: 440; lines: 1 }
            text r.detail { at: 552, 13; anchor: right center; size: 10.5; color: #8b8f95; width: 120; lines: 1; align: right }
        }
        //  4 · it asks you
        group {
            show: r.kind == 4
            body {
                color: #24211a
                rim: 8%
                box { from: 0, 0; size: 556, asked.height + 66; corner: 14 }
            }
            box { from: 0, 0; size: 556, asked.height + 66; corner: 14; stroke: 1 + 1.2 * chat.ask * (r.state == 0); color: amber
                  opacity: if(r.state == 0, 45% + 35% * (0.5 + 0.5 * sin(chat.t * 220)), 25%) }
            text r.detail { at: 16, 16; anchor: left center; size: 9.5; weight: 700; color: amber; width: 400; lines: 1 }
            text r.text { at: 16, 30; anchor: left top; width: 520; size: 12.5; color: ink; measure: asked; selectable: true; selection: #5a4a2a }
            group {
                show: r.state == 0
                box { from: 316, asked.height + 34; size: 110, 28; corner: 9; color: #2a2b2c; opacity: 80% + 20% * deny.glow }
                text "Not this" { at: 371, asked.height + 48; anchor: center; size: 11.5; weight: 600; color: ink }
                box { from: 432, asked.height + 34; size: 110, 28; corner: 9; color: amber; opacity: 85% + 15% * allow.glow }
                text "Allow" { at: 487, asked.height + 48; anchor: center; size: 11.5; weight: 700; color: #0c0f12 }
                zone box deny_zone { from: 316, asked.height + 34; size: 110, 28; corner: 9; cursor: pointer; active: chatting }
                zone box allow_zone { from: 432, asked.height + 34; size: 110, 28; corner: 9; cursor: pointer; active: chatting }
            }
            text pick(r.state == 3, "Not allowed", "Allowed") { at: 540, asked.height + 48; anchor: right center; size: 11; color: #8b8f95; show: r.state != 0 }
        }
        //  5 · a note: what failed, what was stopped.
        text r.text { at: 2, 13; anchor: left center; size: 11.5; color: #ef7a66; width: 540; lines: 2; show: r.kind == 5; selectable: true; selection: #5a3a34 }
        }
        on enter allow_zone { allow.glow: 1 }
        on leave allow_zone { allow.glow: 0 }
        on enter deny_zone { deny.glow: 1 }
        on leave deny_zone { deny.glow: 0 }
        on press allow_zone { emit chat_allow(r.index) }
        on press deny_zone { emit chat_deny(r.index) }
    }

    //  A picture you gave her to show what you mean, in where you write;
    //  pressed, it goes.
    component RefChip(r: record) {
        size: 32, 32
        prop gone.glow = 0 ~140ms
        image r.pic { at: 1, 1; size: 30, 30 }
        box { at: 16, 16; size: 30, 30; corner: 7; stroke: 1; color: mint; opacity: 35% + 40% * gone.glow }
        box { at: 16, 16; size: 30, 30; corner: 7; color: #0c0f12; opacity: 55% * gone.glow }
        text "×" { at: 16, 15; anchor: center; size: 16; weight: 700; color: ink; opacity: gone.glow }
        zone box chip { at: 16, 16; size: 32, 32; corner: 7; cursor: pointer; active: chatting }
        on enter chip { gone.glow: 1 }
        on leave chip { gone.glow: 0 }
        on press chip { emit build_ref_remove(r.index) }
    }

    group {
    clip inset 2 box { at: chat.x, chat.y; size: chat.w, chat.h; corner: 24 * chat }
    group {
        opacity: chat_content
        move: 0, (1 - chat_content) * 10
        let kx0 = chat.x - 278
        let ky0 = chat.y - chat.h / 2
        //  The head: who she is, and with what.
        text "MAREA" { at: kx0, ky0 + 24; anchor: left center; size: 9; weight: 600; color: mint; opacity: 80%; show: not build.on }
        text chat.model { at: kx0 + 48, ky0 + 24; anchor: left center; size: 9.5; color: #8b8f95; width: 300; lines: 1; show: not build.on and not chat.attached }
        //  Joined to a window: whose, and the way out (she is sitting on it).
        group {
            show: chat.attached and not build.on
            prop chat_letgo.glow = 0 ~140ms
            ellipse { at: kx0 + 54, ky0 + 24; radius: 3; color: mint }
            text "{upper(chat.joined)}" { at: kx0 + 64, ky0 + 24; anchor: left center; size: 9.5; weight: 700; color: mint; width: 260; lines: 1 }
            box { at: kx0 + 450, ky0 + 24; size: 72, 22; corner: 8; color: #2a2b2c; opacity: 70% + 30% * chat_letgo.glow }
            text "Let go" { at: kx0 + 450, ky0 + 24; anchor: center; size: 10.5; weight: 600; color: ink }
            zone box chat_letgo_btn { at: kx0 + 450, ky0 + 24; size: 72, 22; corner: 8; cursor: pointer; label: "Let go of the window"; active: chatting and chat.attached and not build.on }
            on enter chat_letgo_btn { chat_letgo.glow: 1 }
            on leave chat_letgo_btn { chat_letgo.glow: 0 }
            on press chat_letgo_btn { emit chat_detach }
        }
        //  Building: what is being made, and its three ways out.
        group {
            show: build.on
            prop build_undo.glow = 0 ~140ms
            prop build_throw.glow = 0 ~140ms
            prop build_keep.glow = 0 ~140ms
            text "BUILDING" { at: kx0, ky0 + 24; anchor: left center; size: 9; weight: 600; color: amber; opacity: 90% }
            text build.name { at: kx0 + 66, ky0 + 24; anchor: left center; size: 11; weight: 600; color: ink; width: 150; lines: 1 }
            box { at: kx0 + 262, ky0 + 24; size: 64, 24; corner: 8; color: #2a2b2c; opacity: 70% + 30% * build_undo.glow }
            text "Undo" { at: kx0 + 262, ky0 + 24; anchor: center; size: 10.5; weight: 600; color: ink }
            box { at: kx0 + 344, ky0 + 24; size: 88, 24; corner: 8; color: #2a2b2c; opacity: 70% + 30% * build_throw.glow }
            text "Throw away" { at: kx0 + 344, ky0 + 24; anchor: center; size: 10.5; weight: 600; color: #ef7a66 }
            box { at: kx0 + 444, ky0 + 24; size: 96, 24; corner: 8; color: mint; opacity: 80% + 20% * build_keep.glow }
            text "Keep it" { at: kx0 + 444, ky0 + 24; anchor: center; size: 10.5; weight: 700; color: #0c0f12 }
            zone box build_undo_zone { at: kx0 + 262, ky0 + 24; size: 64, 24; corner: 8; cursor: pointer; active: chatting and build.on }
            zone box build_throw_zone { at: kx0 + 344, ky0 + 24; size: 88, 24; corner: 8; cursor: pointer; active: chatting and build.on }
            zone box build_keep_zone { at: kx0 + 444, ky0 + 24; size: 96, 24; corner: 8; cursor: pointer; active: chatting and build.on }
            on enter build_undo_zone { build_undo.glow: 1 }
            on leave build_undo_zone { build_undo.glow: 0 }
            on enter build_throw_zone { build_throw.glow: 1 }
            on leave build_throw_zone { build_throw.glow: 0 }
            on enter build_keep_zone { build_keep.glow: 1 }
            on leave build_keep_zone { build_keep.glow: 0 }
            on press build_undo_zone { emit build_undo }
            on press build_throw_zone { emit build_discard }
            on press build_keep_zone { emit build_keep }
        }
        prop new.glow = 0 ~140ms
        group {
            show: not build.on
            opacity: 55% + 45% * new.glow
            line { from: kx0 + 512, ky0 + 24; to: kx0 + 524, ky0 + 24; width: 1.6; color: ink }
            line { from: kx0 + 518, ky0 + 18; to: kx0 + 518, ky0 + 30; width: 1.6; color: ink }
        }
        zone box new_chat { at: kx0 + 518, ky0 + 24; size: 28, 28; corner: 14; cursor: pointer; active: chatting and not build.on }
        box { at: kx0 + 548, ky0 + 24; size: 36, 22; corner: 7; color: #202021 }
        text "Esc" { at: kx0 + 548, ky0 + 24; anchor: center; size: 10.5; color: #8b8f95 }
        line { from: kx0, ky0 + 44; to: kx0 + 556, ky0 + 44; width: 1; color: ink; opacity: 8% }
        //  The water under the thread, moving while she works.
        shader chat_tide { at: chat.x, ky0 + 45 + (chat.h - 45) / 2; size: chat.w, chat.h - 45; values: chat.stir; colors: mint }
        //  The thread. It scrolls with the wheel and by dragging, and follows
        //  what arrives while you are at the bottom of it.
        //  Under the rows, not over them: the wheel and a drag reach any zone
        //  underneath, and a press goes to the topmost. Declared after the
        //  thread, it took every click in it —a card's Allow did nothing—.
        zone box chat_area { from: kx0, ky0 + 56; size: 556, 404; active: chatting }
        column chat_list ~quick {
            at: kx0, ky0 + 56
            view: 556, 404
            gap: 12
            for r in chat.rows { ChatRow(r) }
        }
        //  (Its length, in a property a rule can read: a layout's own names
        //  are only known by the drawing of its group.)
        follow chat.length = chat_list.content
        follow chat.from_end = chat_list.content - chat_list.scroll
        //  Following the end: while you are at the bottom, whatever grows the
        //  thread (a row, a letter, a measure that arrives a frame later) keeps
        //  it there. Only you let go of it —the wheel up, or dragging the
        //  thread down—, never a jump of the thread's own; back at the bottom,
        //  it follows again. Sending something goes back to the end.
        on scroll chat_area while wheel > 0 { chat.stuck = false }
        on drag chat_area while drag.dy > 12 { chat.stuck = false }
        on change chat_list.scroll while chat_list.content - chat_list.scroll < 420 { chat.stuck = true }
        on change chat_list.content while chat.stuck { chat_list.scroll: max(0, chat_list.content - 404) ~0ms }
        on change chat.rows.count while chat.rows.count == 0 { chat.stuck = true }
        on chat_send { chat.stuck = true; chat_list.scroll: max(0, chat_list.content - 404) ~0ms }
        //  And whatever still leaves it off the end while it follows —the
        //  thread shrinking as old rows leave the top, a measure that came
        //  late—, it is brought back to it.
        every 150ms while chatting and chat.stuck and abs(max(0, chat_list.content - 404) - chat_list.scroll) > 1 {
            chat_list.scroll: max(0, chat_list.content - 404) ~quick
        }
        //  Nothing said yet: a few words of hers and what she can do.
        group {
            show: chat.rows.count < 1 and chat.signed_in
            text "Ask me anything" { at: chat.x, ky0 + 200; anchor: center; size: 20; weight: 500; color: ink; opacity: 85% }
            text "I can also use your desktop: open the browser, look something up, fill a form. I will ask before each step." { at: chat.x, ky0 + 238; anchor: center; size: 12; color: #8b8f95; width: 420; lines: 3; align: center }
        }
        //  Not signed in: the way to, right here.
        prop chat.login.glow = 0 ~140ms
        group {
            show: not chat.signed_in
            text "To talk, she needs an account" { at: chat.x, ky0 + 186; anchor: center; size: 18; weight: 500; color: ink; opacity: 85% }
            text pick(if(chat.signing, 1, 0), "Your ChatGPT account: the browser opens to sign in, and she remembers it.", "Finish signing in, in your browser") { at: chat.x, ky0 + 220; anchor: center; size: 12; color: #8b8f95; width: 420; lines: 2; align: center }
            box { at: chat.x, ky0 + 272; size: 168, 38; corner: 19; color: mix(mix(#3d6b5c, #4a8270, chat.login.glow), #2a2d30, chat.signing) }
            text pick(if(chat.signing, 1, 0), "Sign in", "Cancel") { at: chat.x, ky0 + 272; anchor: center; size: 13; weight: 600; color: ink }
        }
        zone box chat_login_btn { at: chat.x, ky0 + 272; size: 168, 38; corner: 19; cursor: pointer; active: chatting and not chat.signed_in }
        on enter chat_login_btn { chat.login.glow: 1 }
        on leave chat_login_btn { chat.login.glow: 0 }
        on press chat_login_btn while chat.signing { emit chat_login_cancel }
        on press chat_login_btn while not chat.signing { emit chat_login }
        //  Working: the water at the foot of the thread breathes —three waves,
        //  out of phase— and says what she is on.
        group {
            show: chat.state == thinking or chat.state == acting or chat.state == starting
            repeat w in 0..3 {
                path { at: kx0, ky0 + 468; color: mix(mint, #c9b3f2, w / 2); stroke: 1.6; opacity: 55% - 15% * w
                       move 0, 0
                       curve 140, 4 * sin(chat.t * 120 + w * 70) via 70, -6 * sin(chat.t * 90 + w * 60)
                       curve 280, 0 via 210, 6 * sin(chat.t * 150 + w * 50)
                       curve 420, -4 * sin(chat.t * 110 + w * 80) via 350, -6 * sin(chat.t * 130 + w * 40)
                       curve 556, 0 via 490, 5 * sin(chat.t * 100 + w * 90) }
            }
            text chat.status { at: kx0 + 2, ky0 + 480; anchor: left center; size: 10.5; color: #8b8f95; width: 480; lines: 1 }
        }
        text chat.status { at: kx0 + 2, ky0 + 480; anchor: left center; size: 10.5; color: #ef7a66; width: 540; lines: 1; show: chat.state == offline }
        //  What you write. Enter sends; while she works, Stop. Building, it
        //  also takes pictures: dropped on it, a piece of the screen, or pasted.
        //  Under the rest: a drop goes to it wherever nothing else is.
        zone box build_drop { from: kx0, ky0 + 496; size: 556, 44; corner: 14; active: chatting }
        let refs_w = build.refs.count * 36
        box { from: kx0, ky0 + 496; size: 556, 44; corner: 14; color: #141415 }
        box { from: kx0, ky0 + 496; size: 556, 44; corner: 14; stroke: 1 + drag.over * build.on; color: mint; opacity: 18% + 50% * drag.over * build.on }
        row { at: kx0 + 8, ky0 + 502; gap: 4; show: build.on; for r in build.refs { RefChip(r) } }
        //  (An input's `at` is the top of its line: 14 px × 1.3, centred on 518.)
        input chat.input { at: kx0 + 16 + refs_w, ky0 + 509; width: 470 - refs_w - 72 * build.on; size: 14; color: ink; placeholder: "Ask Marea…"; selection: #2f5f52; show: not keys.asking }
        //  Building: a piece of the screen, and what you copied, as references.
        prop shot.glow = 0 ~140ms
        prop paste.glow = 0 ~140ms
        group {
            show: build.on and not keys.asking
            ellipse { at: kx0 + 464, ky0 + 518; radius: 14; color: #24262a; opacity: 70% + 30% * paste.glow }
            box { at: kx0 + 464, ky0 + 520; size: 11, 13; corner: 2; stroke: 1.5; color: ink }
            box { at: kx0 + 464, ky0 + 513; size: 6, 3; corner: 1; color: ink }
            ellipse { at: kx0 + 496, ky0 + 518; radius: 14; color: #24262a; opacity: 70% + 30% * shot.glow }
            box { at: kx0 + 496, ky0 + 519; size: 15, 11; corner: 3; stroke: 1.5; color: ink }
            ellipse { at: kx0 + 496, ky0 + 519; radius: 3; stroke: 1.4; color: ink }
            text build.hint { at: kx0 + 2, ky0 + 480; anchor: left center; size: 10.5; color: amber; width: 540; lines: 1 }
        }
        zone ellipse build_paste_btn { at: kx0 + 464, ky0 + 518; radius: 14; cursor: pointer; label: "Paste a picture"; active: chatting and build.on and not keys.asking }
        zone ellipse build_shot_btn { at: kx0 + 496, ky0 + 518; radius: 14; cursor: pointer; label: "A piece of the screen as a reference"; active: chatting and build.on and not keys.asking }
        on enter build_paste_btn { paste.glow: 1 }
        on leave build_paste_btn { paste.glow: 0 }
        on enter build_shot_btn { shot.glow: 1 }
        on leave build_shot_btn { shot.glow: 0 }
        on press build_paste_btn { emit build_ref_paste }
        on press build_shot_btn { emit build_ref_capture }
        prop send.glow = 0 ~140ms
        let busy = chat.state == thinking or chat.state == acting or chat.state == awaiting or chat.state == starting
        group {
            show: not keys.asking
            ellipse { at: kx0 + 532, ky0 + 518; radius: 15; color: mix(mint, #ef7a66, busy); opacity: 80% + 20% * send.glow }
            path { at: kx0 + 526, ky0 + 511; color: #0c0f12; stroke: 2; show: not busy
                   move 6, 13; line 6, 1 }
            path { at: kx0 + 526, ky0 + 511; color: #0c0f12; stroke: 2; show: not busy
                   move 1, 6; line 6, 1; line 11, 6 }
            box { at: kx0 + 532, ky0 + 518; size: 10, 10; corner: 2; color: #0c0f12; show: busy }
        }
        zone ellipse send_btn { at: kx0 + 532, ky0 + 518; radius: 16; cursor: pointer; active: chatting and not keys.asking }
        //  She asks you for a password: where you write turns amber, beating,
        //  with a padlock, and takes it hidden. Enter or Keep puts it in your
        //  keyring; she is only told it is there.
        prop keys.give.glow = 0 ~140ms
        prop keys.refuse.glow = 0 ~140ms
        group {
            show: keys.asking
            box { from: kx0, ky0 + 496; size: 556, 44; corner: 14; color: #1c1912 }
            box { from: kx0, ky0 + 496; size: 556, 44; corner: 14; stroke: 1.2; color: amber; opacity: 40% + 35% * (0.5 + 0.5 * sin(chat.t * 220)) }
            box { at: kx0 + 24, ky0 + 521; size: 13, 9; corner: 2; color: amber }
            path { at: kx0 + 20, ky0 + 509; color: amber; stroke: 1.6
                   move 0, 8; line 0, 5; curve 8, 5 via 4, -1; line 8, 8 }
            input keys.answer { at: kx0 + 44, ky0 + 509; width: 330; size: 14; color: ink; placeholder: "Password"; secret: true; agent: no; selection: #5a4a2a }
            box { at: kx0 + 432, ky0 + 518; size: 80, 28; corner: 9; color: #2a2b2c; opacity: 80% + 20% * keys.refuse.glow }
            text "Not now" { at: kx0 + 432, ky0 + 518; anchor: center; size: 11.5; weight: 600; color: ink }
            box { at: kx0 + 513, ky0 + 518; size: 72, 28; corner: 9; color: amber; opacity: 85% + 15% * keys.give.glow }
            text "Keep" { at: kx0 + 513, ky0 + 518; anchor: center; size: 11.5; weight: 700; color: #0c0f12 }
            text keys.prompt { at: kx0 + 2, ky0 + 480; anchor: left center; size: 10.5; color: amber; width: 540; lines: 1 }
        }
        zone box keys_refuse_btn { at: kx0 + 432, ky0 + 518; size: 80, 28; corner: 9; cursor: pointer; active: chatting and keys.asking }
        zone box keys_give_btn { at: kx0 + 513, ky0 + 518; size: 72, 28; corner: 9; cursor: pointer; active: chatting and keys.asking }
    }
    }
    on enter new_chat { new.glow: 1 }
    on leave new_chat { new.glow: 0 }
    on press new_chat { emit chat_new }
    on enter send_btn { send.glow: 1 }
    on leave send_btn { send.glow: 0 }
    on press send_btn while chat.state == thinking or chat.state == acting or chat.state == awaiting or chat.state == starting { emit chat_stop }
    on press send_btn while not (chat.state == thinking or chat.state == acting or chat.state == awaiting or chat.state == starting) { emit chat_send }
    on submit chat.input { emit chat_send }
    on enter keys_give_btn { keys.give.glow: 1 }
    on leave keys_give_btn { keys.give.glow: 0 }
    on enter keys_refuse_btn { keys.refuse.glow: 1 }
    on leave keys_refuse_btn { keys.refuse.glow: 0 }
    on press keys_give_btn { emit keys_give }
    on press keys_refuse_btn { emit keys_refuse }
    on submit keys.answer { emit keys_give }
    //  The keyboard goes where the answer is written.
    on change keys.asking while keys.asking and chatting { focus keys.answer }
    on change keys.asking while not keys.asking and chatting { focus chat.input }
    on change chatting while chatting and keys.asking { focus keys.answer }

}
