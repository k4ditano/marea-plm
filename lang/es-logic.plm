// What marea.luau writes itself, in Spanish. The logic writes it in English
// through `tr("…")`; this is the table `tr` reads when `locale` is `es`.
//
// Both libraries fill the same table, and a text translated twice is an error:
// what the scene also writes —the demo batch's rows it starts with, «now»,
// «History»— is already in es.plm, and the logic uses those same English words.
library SpanishLogic {
    translations es {
        // the finder
        // what is hers, in the finder («Agents», «Settings»… are in es.plm)
        "Lock the screen" = "Bloquear la pantalla"
        "Screenshot of a region" = "Captura de una zona"
        "Screenshot of the screen" = "Captura de la pantalla"
        "Screenshot of a window" = "Captura de una ventana"
        "Record the screen" = "Grabar la pantalla"
        "Celebrate" = "Celebrar"
        "Rage" = "Enfado"
        "Adventure" = "Aventura"
        // pleamar-wm's window manager, from her menu and her finder
        "Windows" = "Ventanas"
        "Tiled or free windows" = "Ventanas en mosaico o libres"
        "Bring back every window" = "Recuperar todas las ventanas"
        "Rain on the windows" = "Lluvia en las ventanas"
        "Rain intensity" = "Intensidad de la lluvia"
        "Her sky" = "Su cielo"
        "Clear sky" = "Despejado"
        "Mostly clear" = "Casi despejado"
        "Partly cloudy" = "Algo nublado"
        "Overcast" = "Cubierto"
        "Fog" = "Niebla"
        "Drizzle" = "Llovizna"
        "Heavy rain" = "Lluvia fuerte"
        "Snow" = "Nieve"
        "Heavy snow" = "Nevada fuerte"
        "Showers" = "Chubascos"
        "Heavy showers" = "Chubascos fuertes"
        "Snow showers" = "Chubascos de nieve"
        "Thunderstorm" = "Tormenta"
        "Window" = "Ventana"
        "On" = "Encendido"
        "Yesterday" = "Ayer"
        "Notice history" = "Historial de avisos"
        "Her library" = "Su biblioteca"
        "Desktop" = "Escritorio"
        "Back in 15 minutes" = "Vuelve en 15 minutos"
        "Back in an hour" = "Vuelve en una hora"
        "Back in three hours" = "Vuelve en tres horas"
        "%s muted" = "%s silenciada"
        "Do not disturb: on" = "No molestar: activado"
        "Do not disturb: off" = "No molestar: desactivado"
        "Keep what is copied" = "Guardar lo copiado"
        "Kept in %s" = "Guardado en %s"
        "It was already there" = "Ya lo tenía"
        "Could not keep it" = "No pude guardarlo"
        // her library's page
        "Favourites" = "Favoritas"
        "Projects" = "Proyectos"
        "Nothing kept today" = "Hoy no ha guardado nada"
        "No favourites yet: the star on a card" = "Aún no hay favoritas: la estrella de cada tarjeta"
        "The trash is empty" = "La papelera está vacía"
        "Nothing in this folder yet" = "Esta carpeta aún está vacía"
        "Nothing tagged #%s" = "Nada con la etiqueta #%s"
        "Nothing matches «%s»" = "Nada encaja con «%s»"
        "Copied" = "Copiado"
        "Back from the trash" = "Sacado de la papelera"
        "In the trash" = "A la papelera"
        "Moved to %s" = "Movido a %s"
        "Out of its folder" = "Fuera de su carpeta"
        "No folder" = "Sin carpeta"
        "Image" = "Imagen"
        "Video" = "Vídeo"
        "Audio" = "Audio"
        "Document" = "Documento"
        "Code" = "Código"
        "Note" = "Nota"
        "Off" = "Apagado"
        "Snow on the windows" = "Nieve en las ventanas"
        "Ride a window" = "Súbete a una ventana"

        // the calendar
        "January" = "enero"
        "February" = "febrero"
        "March" = "marzo"
        "April" = "abril"
        "May" = "mayo"
        "June" = "junio"
        "July" = "julio"
        "August" = "agosto"
        "September" = "septiembre"
        "October" = "octubre"
        "November" = "noviembre"
        "December" = "diciembre"
        "Monday" = "Lunes"
        "Tuesday" = "Martes"
        "Wednesday" = "Miércoles"
        "Thursday" = "Jueves"
        "Friday" = "Viernes"
        "Saturday" = "Sábado"
        "Sunday" = "Domingo"
        "Mo" = "L"
        "Tu" = "M"
        "We" = "X"
        "Th" = "J"
        "Fr" = "V"
        "Sa" = "S"
        "Su" = "D"
        "Free day" = "Día libre"
        "1 event" = "1 evento"
        "%d events" = "%d eventos"
        "all day" = "todo el día"
        "%s %d" = "%s de %d"

        // the agents' reservoirs
        "5 hours" = "5 horas"
        "Weekly" = "Semanal"
        "server" = "servidor"
        "on this machine" = "en este equipo"
        "just now" = "ahora mismo"
        "%s ago" = "hace %s"
        "renewed?" = "¿renovada?"
        "not started" = "sin empezar"
        "in %s" = "en %s"

        "Application" = "Aplicación"
        "Folder" = "Carpeta"
        "File" = "Archivo"

        // her menu: the plugins that bring something, and what they bring
        // («History» is in es.plm)
        "Drift" = "Deriva"
        "Swell" = "Oleaje"
        "Lend something" = "Prestar algo"
        "Release what was lent" = "Soltar lo prestado"

        // the system tray: going back up a submenu
        "‹  Back" = "‹  Volver"

        // the swell: a real notice whose application has no name
        "notice" = "aviso"

        // the swell in demo mode: what of the invented batch is not in es.plm
        "I'll call you in five" = "te llamo en cinco"
        "Battery at 8 %" = "Batería al 8 %"
        "about 12 minutes left" = "quedan unos 12 minutos"
        // software
        "Install programs" = "Instalar programas"
        "checked just now" = "mirado ahora mismo"
        "checked %d min ago" = "mirado hace %d min"
        "checked at %s" = "mirado a las %s"
        "%d to update" = "%d por actualizar"
        "%d from the AUR" = "%d del AUR"
        "%s to download" = "%s que descargar"
        "%d more" = "%d más"
        "Arch news before updating" = "Noticias de Arch antes de actualizar"
        "%d updates waiting" = "%d actualizaciones esperando"
        "Software, in her control center, updates them" = "Programas, en su centro de control, las actualiza"
        "The repositories did not answer: is there a connection?" = "Los repositorios no contestaron: ¿hay conexión?"
        "Refreshing the lists" = "Refrescando las listas"
        "Downloading" = "Descargando"
        "%s · %d of %d" = "%s · %d de %d"
        "Checking what was downloaded" = "Comprobando lo descargado"
        "Installing" = "Instalando"
        "Updating" = "Actualizando"
        "Finishing" = "Terminando"
        "Building %s" = "Compilando %s"
        "%d of %d from the AUR" = "%d de %d del AUR"
        "%s is installed" = "%s está instalado"
        "Updated %d packages" = "%d paquetes actualizados"
        "There was nothing left to update" = "No quedaba nada por actualizar"
        "Stopped" = "Detenido"
        "The password was not accepted" = "La contraseña no se aceptó"
        "It did not finish" = "No terminó"
        "Installing %s" = "Instalando %s"
        "Starting" = "Empezando"
        "The AUR needs yay or paru" = "El AUR necesita yay o paru"
        "Your password, to update %d packages" = "Tu contraseña, para actualizar %d paquetes"
        "Your password, to install %s" = "Tu contraseña, para instalar %s"
        "That was not it (or this user cannot use sudo)" = "No era esa (o este usuario no puede usar sudo)"
        "No kitty to open a terminal with" = "No hay kitty para abrir una terminal"
        // the chat
        "Talk with Marea" = "Hablar con Marea"
        "Looking at your windows" = "Mirando tus ventanas"
        "Looking at %s" = "Mirando %s"
        "Click in %s" = "Pulsar en %s"
        "Type in %s" = "Escribir en %s"
        "A key in %s" = "Una tecla en %s"
        "Keys in %s" = "Teclas en %s"
        "Scroll in %s" = "Desplazar en %s"
        "Drag in %s" = "Arrastrar en %s"
        "Bring %s forward" = "Traer %s delante"
        "Move %s to another monitor" = "Llevar %s a otro monitor"
        "a dialog" = "un diálogo"
        "Open %s" = "Abrir %s"
        "No model to talk with yet: her sign-in is missing" = "Aún no tiene con qué hablar: falta su inicio de sesión"
        "Thinking…" = "Pensando…"
        "Waiting for you" = "Esperándote"
        "Stopped." = "Detenido."
        "Signed in with %s" = "Con la sesión de %s"
        "That model cannot be used with her account: choose another in Settings" = "Ese modelo no se puede usar con su cuenta: elige otro en Ajustes"
        "The sign-in did not finish: " = "El inicio de sesión no terminó: "
        "She could not hear it: she is not signed in (Settings › Talking with her)." = "No pudo oírlo: no tiene sesión (Ajustes › Hablar con ella)."
        "You stopped her from the monitor." = "La paraste desde el monitor."
        "Something went wrong: " = "Algo salió mal: "
        "Her engine stopped." = "Su motor se paró."
        "Her engine cannot start: " = "Su motor no puede arrancar: "
        "Waking up…" = "Despertando…"
        "Her engine could not start: " = "Su motor no pudo arrancar: "
        // her memory
        "Remembered: " = "Recordado: "
        "Forgot: " = "Olvidado: "
        "Noted how to: " = "Apuntado cómo: "
        "Remembering: " = "Recordando: "
        "Reading her note: " = "Leyendo su nota: "
        "Looking back: " = "Buscando en lo hablado: "
        "None kept yet" = "Ninguna guardada aún"
        "%d kept on this computer" = "%d guardadas en este equipo"
        "%d things, %d notes" = "%d cosas, %d notas"
        // her tasks
        "A task of her own" = "Una tarea suya"
        "%s, at %s" = "%s, a las %s"
        "Kept as a task: %s, at %s" = "Guardada como tarea: %s, a las %s"
        "Every day" = "Todos los días"
        "Weekdays" = "Entre semana"
        "Weekends" = "Fines de semana"
        "Sun" = "Dom"
        "Mon" = "Lun"
        "Tue" = "Mar"
        "Wed" = "Mié"
        "Thu" = "Jue"
        "Fri" = "Vie"
        "Sat" = "Sáb"
        "Not done yet" = "Aún no se ha hecho"
        "Done " = "Hecha "
        "Not done " = "Sin hacer "
        "Doing it now…" = "Haciéndola ahora…"
        "None yet" = "Ninguna"
        "%d on" = "%d activas"
        "Marea could not do a task" = "Marea no pudo hacer una tarea"
        "«%s», at %s: %s. Shall she do it now?" = "«%s», a las %s: %s. ¿La hace ahora?"
        "Do it now" = "Hacerla ahora"
        "Leave it" = "Dejarla"
        "the screen was locked" = "la pantalla estaba bloqueada"
        "she is not signed in" = "no tiene la sesión iniciada"
        "the computer was off, or Marea was not running" = "el ordenador estaba apagado o Marea no estaba en marcha"
        "Task" = "Tarea"
        "Doing one of her tasks…" = "Haciendo una de sus tareas…"
        "Marea did a task" = "Marea hizo una tarea"
        "Marea could not finish a task" = "Marea no pudo terminar una tarea"
        "See it" = "Verla"
        "Forgot the task: " = "Olvidada la tarea: "
        "She is not signed in." = "No tiene la sesión iniciada."
        "A name and a password, both" = "Un nombre y una contraseña, las dos cosas"
        "The keyring did not take it" = "El llavero no la aceptó"
        "Kept as «%s»" = "Guardada como «%s»"
        "Asks you for the password of «%s»" = "Te pide la contraseña de «%s»"
        "The password of «%s»: it goes to your keyring, she never sees it" = "La contraseña de «%s»: va a tu llavero, ella nunca la ve"
        "Type a saved password in %s" = "Escribir una contraseña guardada en %s"
            // the system pages
        "Excellent signal" = "Señal excelente"
        "Good signal" = "Buena señal"
        "Fair signal" = "Señal regular"
        "Weak signal" = "Señal débil"
        "Joining…" = "Conectando…"
        "Connected by cable" = "Conectado por cable"
        "Wi-Fi is off" = "Wi-Fi apagado"
        "Its radio is resting" = "Su radio descansa"
        "Not connected" = "Sin conexión"
        "Choose a network below" = "Elige una red de abajo"
        "Could not join «%s»" = "No se pudo conectar a «%s»"
        "Forgot «%s»" = "Olvidado: «%s»"
        "Scan it with your phone to join «%s»." = "Escanéalo con el móvil para unirte a «%s»."
        "It could not be read" = "No se pudo leer"
        "None: it is open" = "Ninguna: es abierta"
        "Password copied" = "Contraseña copiada"
        "Connected" = "Conectado"
        "Paired" = "Emparejado"
        "New · press Pair" = "Nuevo · pulsa Emparejar"
        "Disconnecting…" = "Desconectando…"
        "Connecting…" = "Conectando…"
        "Pairing…" = "Emparejando…"
        "«%s» did not answer" = "«%s» no respondió"
