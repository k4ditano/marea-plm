        "%d of %d" = "%d de %d"
        "until %s" = "hasta las %s"
        "%d min of focus today" = "%d min concentrada hoy"
        "Share the Wi-Fi" = "Compartir el Wi-Fi"
        // building a piece of the desktop with her (logic/builder.luau)
        "Build something" = "Construir algo"
        "Bar" = "Barra"
        "Marea is making it…" = "Marea lo está haciendo…"
        "Tell me what it should be: its colours, its shape, what it shows and does. I will make it right there, as you watch." = "Dime cómo tiene que ser: sus colores, su forma, qué muestra y qué hace. Lo haré ahí mismo, mientras miras."
        "Reading %s" = "Leyendo %s"
        "Writing %s" = "Escribiendo %s"
