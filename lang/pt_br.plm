// The Brazilian Portuguese of what the scene itself writes: each English text as
// it appears in marea.plm, and what it becomes in Portuguese. The logic's own
// strings live in pt_br-logic.plm; the demo batch's rows the scene starts with are
// here, and the logic uses these same English words for them.
library PortugueseUi {
    translations pt_br {
        "Networks" = "Redes"
        "Apps" = "Apps"
        "Previous month" = "Mês anterior"
        "Next month" = "Próximo mês"
        "Mute the output" = "Silenciar a saída"
        "Mute the input" = "Silenciar a entrada"
        "Output volume" = "Volume de saída"
        "Input volume" = "Volume de entrada"
        "Mute {a.name}" = "Silenciar {a.name}"
        "{a.name} volume" = "Volume de {a.name}"
        "Refresh" = "Atualizar"
        "Close" = "Fechar"
        "Mute sound" = "Silenciar o som"
        "Mute microphone" = "Silenciar o microfone"
        "Previous" = "Anterior"
        "Play" = "Tocar"
        "Pause" = "Pausar"
        "Next" = "Próxima"
        "Marea" = "Marea"
        "Outside Marea: closes what is open" = "Fora da Marea: fecha o que estiver aberto"
        "CALENDAR" = "CALENDÁRIO"
        "Agents" = "Agentes"
        "Today" = "Hoje"
        "Siempre en español" = "Siempre en español"
        "Sempre em português" = "Sempre em português"
        "ES" = "ES"
        "EN" = "EN"
        "PT" = "PT"
        "Aa" = "Aa"
        "Language" = "Idioma"
        "Safety net" = "Rede de segurança"
        "While you try it out, a safety net: Esc also opens it, and it opens by itself after a minute." = "Enquanto você testa, uma rede de segurança: o Esc também desbloqueia, e ela se abre sozinha depois de um minuto."
        "Her lock screen opens with your password." = "A tela de bloqueio dela abre com a sua senha."
        "Always in English" = "Sempre em inglês"
        "The one your session speaks" = "O que a sua sessão fala"
        "The language she speaks in." = "O idioma em que ela fala."
        "Her home" = "A casa dela"
        "Choose her monitor, or let her follow you." = "Escolha o monitor dela, ou deixe que ela siga você."
        "Pieces and the background" = "Acessórios e o fundo"
        "Notices" = "Avisos"
        "All of them arrive" = "Todos chegam"
        "One app muted" = "Um app silenciado"
        "Some apps muted" = "Alguns apps silenciados"
        "Do not disturb" = "Não perturbe"
        "Quiet ones still arrive: they go to their drop, without a card." = "Os silenciosos chegam mesmo assim: vão para a gota deles, sem cartão."
        "Only the urgent ones get through" = "Só os urgentes passam"
        "Quiet while recording or sharing" = "Silêncio ao gravar ou compartilhar"
        "None of them ends up in your video or your call. Locked, always quiet" = "Nenhum aparece no seu vídeo nem na sua chamada. Bloqueada, sempre em silêncio"
        "LATER BRINGS IT BACK IN" = "«DEPOIS» TRAZ DE VOLTA EM"
        "15 minutes" = "15 minutos"
        "An hour" = "Uma hora"
        "Three hours" = "Três horas"
        "MUTED APPS" = "APPS SILENCIADOS"
        "None. The bell on a notice mutes its app." = "Nenhum. O sino de um aviso silencia o app dele."
        "Password only" = "Só senha"
        "Safety net on" = "Rede de segurança ativa"
        "Follows you" = "Segue você"
        "Wardrobe and wallpaper" = "Guarda-roupa e papel de parede"
        "The lock" = "O bloqueio"
        "Her look" = "A aparência dela"
        "Where she lives" = "Onde ela mora"
        "Recording" = "Gravação"
        "She goes to a corner" = "Ela vai para um canto"
        "She stays, with a red eye" = "Ela fica, com um olho vermelho"
        "Stay where she is" = "Ficar onde está"
        "No trip to a corner: only the red eye shows she is recording" = "Sem ir para o canto: só o olho vermelho mostra que ela está gravando"
        "Super+Shift+C starts and stops a recording of the screen." = "Super+Shift+C inicia e para uma gravação da tela."
        "By default she slips into a corner so she is not in your video. If you want to show her own functions on a video, she can stay where she is: her eye turns red and she goes on as usual. The same keys stop it." = "Por padrão ela se esconde num canto para não aparecer no seu vídeo. Se você quiser mostrar as funções dela num vídeo, ela pode ficar onde está: o olho dela fica vermelho e ela continua como sempre. As mesmas teclas param a gravação."
        "Nothing yet." = "Nada ainda."
        "New event: 10:30 Dentist" = "Novo evento: 10:30 Dentista"
