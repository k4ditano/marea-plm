        "She is not signed in." = "Ela está sem login."
        "A name and a password, both" = "Um nome e uma senha, os dois"
        "The keyring did not take it" = "O chaveiro não aceitou"
        "Kept as «%s»" = "Salva como «%s»"
        "Asks you for the password of «%s»" = "Pede a você a senha de «%s»"
        "The password of «%s»: it goes to your keyring, she never sees it" = "A senha de «%s»: vai para o seu chaveiro, ela nunca vê"
        "Type a saved password in %s" = "Digitar uma senha salva em %s"
            // the system pages
        "Excellent signal" = "Sinal excelente"
