        "Application" = "Aplicativo"
        "Folder" = "Pasta"
        "File" = "Arquivo"

        // her menu: the plugins that bring something, and what they bring
        // («History» is in pt_br.plm)
        "Drift" = "Deriva"
        "Swell" = "Ondulação"
        "Lend something" = "Emprestar algo"
        "Release what was lent" = "Soltar o emprestado"

        // the system tray: going back up a submenu
        "‹  Back" = "‹  Voltar"

        // the swell: a real notice whose application has no name
        "notice" = "aviso"

        // the swell in demo mode: what of the invented batch is not in pt_br.plm
        "I'll call you in five" = "te ligo em cinco"
        "Battery at 8 %" = "Bateria em 8 %"
        "about 12 minutes left" = "restam uns 12 minutos"
        // software
        "Install programs" = "Instalar programas"
        "checked just now" = "verificado agora mesmo"
        "checked %d min ago" = "verificado há %d min"
        "checked at %s" = "verificado às %s"
        "%d to update" = "%d para atualizar"
        "%d from the AUR" = "%d do AUR"
        "%s to download" = "%s para baixar"
        "%d more" = "mais %d"
        "Arch news before updating" = "Notícias do Arch antes de atualizar"
        "%d updates waiting" = "%d atualizações esperando"
        "Software, in her control center, updates them" = "Programas, na central de controle dela, atualiza tudo"
        "The repositories did not answer: is there a connection?" = "Os repositórios não responderam: tem conexão?"
        "Refreshing the lists" = "Atualizando as listas"
        "Downloading" = "Baixando"
        "%s · %d of %d" = "%s · %d de %d"
        "Checking what was downloaded" = "Verificando o que foi baixado"
        "Installing" = "Instalando"
        "Updating" = "Atualizando"
        "Finishing" = "Finalizando"
        "Building %s" = "Compilando %s"
        "%d of %d from the AUR" = "%d de %d do AUR"
        "%s is installed" = "%s está instalado"
        "Updated %d packages" = "%d pacotes atualizados"
        "There was nothing left to update" = "Não sobrou nada para atualizar"
        "Stopped" = "Parado"
        "The password was not accepted" = "A senha não foi aceita"
        "It did not finish" = "Não terminou"
        "Installing %s" = "Instalando %s"
        "Starting" = "Iniciando"
        "The AUR needs yay or paru" = "O AUR precisa do yay ou do paru"
        "Your password, to update %d packages" = "Sua senha, para atualizar %d pacotes"
        "Your password, to install %s" = "Sua senha, para instalar %s"
        "That was not it (or this user cannot use sudo)" = "Não era essa (ou este usuário não pode usar sudo)"
        "No kitty to open a terminal with" = "Não há kitty para abrir um terminal"
        // the chat
        "Talk with Marea" = "Conversar com a Marea"
        "Looking at your windows" = "Olhando suas janelas"
        "Looking at %s" = "Olhando %s"
        "Click in %s" = "Clicar em %s"
        "Type in %s" = "Digitar em %s"
        "A key in %s" = "Uma tecla em %s"
        "Keys in %s" = "Teclas em %s"
        "Scroll in %s" = "Rolar em %s"
        "Drag in %s" = "Arrastar em %s"
        "Bring %s forward" = "Trazer %s para frente"
        "Move %s to another monitor" = "Levar %s para outro monitor"
        "a dialog" = "uma caixa de diálogo"
        "Open %s" = "Abrir %s"
        "No model to talk with yet: her sign-in is missing" = "Ainda não tem com o que conversar: falta o login dela"
        "Thinking…" = "Pensando…"
        "Waiting for you" = "Esperando você"
        "Stopped." = "Parado."
        "Signed in with %s" = "Conectada com %s"
        "That model cannot be used with her account: choose another in Settings" = "Esse modelo não pode ser usado com a conta dela: escolha outro em Configurações"
        "The sign-in did not finish: " = "O login não terminou: "
        "She could not hear it: she is not signed in (Settings › Talking with her)." = "Ela não conseguiu ouvir: está sem login (Configurações › Conversar com ela)."
        "You stopped her from the monitor." = "Você a parou pelo monitor."
        "Something went wrong: " = "Algo deu errado: "
        "Her engine stopped." = "O motor dela parou."
        "Her engine cannot start: " = "O motor dela não consegue iniciar: "
        "Waking up…" = "Acordando…"
        "No news for two minutes: Stop cancels it" = "Sem novidades há dois minutos: Parar cancela"
        "Her engine could not start: " = "O motor dela não conseguiu iniciar: "
        // her memory
        "Remembered: " = "Lembrado: "
        "Forgot: " = "Esquecido: "
        "Noted how to: " = "Anotado como: "
        "Remembering: " = "Lembrando: "
