// What marea.luau writes itself, in Brazilian Portuguese. The logic writes it in
// English through `tr("…")`; this is the table `tr` reads when `locale` is `pt_br`.
//
// Both libraries fill the same table, and a text translated twice is an error:
// what the scene also writes —the demo batch's rows it starts with, «now»,
// «History»— is already in pt_br.plm, and the logic uses those same English words.
library PortugueseLogic {
    translations pt_br {
        // the finder
        // what is hers, in the finder («Agents», «Settings»… are in pt_br.plm)
        "Lock the screen" = "Bloquear a tela"
        "Screenshot of a region" = "Captura de uma área"
        "Screenshot of the screen" = "Captura da tela"
        "Screenshot of a window" = "Captura de uma janela"
        "Record the screen" = "Gravar a tela"
        "Celebrate" = "Comemorar"
        "Rage" = "Raiva"
        "Adventure" = "Aventura"
        // pleamar-wm's window manager, from her menu and her finder
        "Windows" = "Janelas"
        "Tiled or free windows" = "Janelas lado a lado ou livres"
        "Bring back every window" = "Trazer de volta todas as janelas"
        "Rain on the windows" = "Chuva nas janelas"
        "Rain intensity" = "Intensidade da chuva"
        "Her sky" = "O céu dela"
        "Clear sky" = "Céu limpo"
        "Mostly clear" = "Quase limpo"
        "Partly cloudy" = "Parcialmente nublado"
        "Overcast" = "Encoberto"
        "Fog" = "Neblina"
        "Drizzle" = "Garoa"
        "Heavy rain" = "Chuva forte"
        "Snow" = "Neve"
        "Heavy snow" = "Nevasca"
        "Showers" = "Pancadas de chuva"
        "Heavy showers" = "Pancadas fortes"
        "Snow showers" = "Pancadas de neve"
        "Thunderstorm" = "Tempestade"
        "Window" = "Janela"
        "On" = "Ligado"
        "Yesterday" = "Ontem"
        "Notice history" = "Histórico de avisos"
        "Her library" = "A biblioteca dela"
        "Desktop" = "Área de trabalho"
        "Back in 15 minutes" = "Volta em 15 minutos"
        "Back in an hour" = "Volta em uma hora"
        "Back in three hours" = "Volta em três horas"
        "%s muted" = "%s silenciado"
        "Do not disturb: on" = "Não perturbe: ativado"
        "Do not disturb: off" = "Não perturbe: desativado"
        "Keep what is copied" = "Guardar o que foi copiado"
        "Kept in %s" = "Guardado em %s"
        "It was already there" = "Já estava lá"
        "Could not keep it" = "Não consegui guardar"
        // her library's page
        "Favourites" = "Favoritos"
        "Projects" = "Projetos"
        "Nothing kept today" = "Nada guardado hoje"
        "No favourites yet: the star on a card" = "Nenhum favorito ainda: a estrela de cada cartão"
        "The trash is empty" = "A lixeira está vazia"
        "Nothing in this folder yet" = "Esta pasta ainda está vazia"
        "Nothing tagged #%s" = "Nada com a etiqueta #%s"
        "Nothing matches «%s»" = "Nada corresponde a «%s»"
        "Copied" = "Copiado"
        "Back from the trash" = "Tirado da lixeira"
        "In the trash" = "Na lixeira"
        "Moved to %s" = "Movido para %s"
        "Out of its folder" = "Fora da pasta"
        "No folder" = "Sem pasta"
        "Image" = "Imagem"
        "Video" = "Vídeo"
        "Audio" = "Áudio"
        "Document" = "Documento"
