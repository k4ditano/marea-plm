        "«%s», at %s: %s. Shall she do it now?" = "«%s», às %s: %s. Ela faz agora?"
        "Do it now" = "Fazer agora"
        "Leave it" = "Deixar"
        "the screen was locked" = "a tela estava bloqueada"
        "she is not signed in" = "ela está sem login"
        "the computer was off, or Marea was not running" = "o computador estava desligado, ou a Marea não estava rodando"
        "Task" = "Tarefa"
        "Doing one of her tasks…" = "Fazendo uma das tarefas dela…"
