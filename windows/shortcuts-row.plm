                            Tile("Keyboard shortcuts", "Windows key and quick actions", windows_to_shortcuts, cell.w, h: 90) {
                                group { size: 32, 26
                                    box { at: 16, 13; size: 30, 22; corner: 4; stroke: 1.5; color: ink }
                                    repeat k in 0..6 { box { at: 7 + mod(k, 3) * 9, 8 + floor(k / 3) * 7; size: 4, 3; corner: 1; color: ink } }
                                    line { from: 10, 20; to: 23, 20; width: 1.5; color: mint }
                                }
                            }
